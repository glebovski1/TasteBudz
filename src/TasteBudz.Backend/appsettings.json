{
  "ConnectionStrings": {
    "TasteBudz": "Data Source=TasteBudz.sqlite;Foreign Keys=True;Pooling=False"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Persistence": {
    "InitializeSqliteOnStartup": false
  },
  "FeatureFlags": {
    "MessagingDirectChatEnabled": false,
    "MessagingGroupChatEnabled": true,
    "NotificationsPushEnabled": false,
    "RestaurantsOperationsEnabled": false,
    "RestaurantsSlotsEnabled": false,
    "RestaurantsDiscountsEnabled": false,
    "PaymentsCheckoutEnabled": false,
    "DiscoveryExperimentalSuggestionsEnabled": false
  },
  "AllowedHosts": "*"
}
