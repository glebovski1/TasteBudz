@model GroupManageViewModel

@{
    ViewData["Title"] = Model.Name;

    var owner = Model.Owner;
    var plannedEvents = Model.PlannedEvents;
    var historyEvents = Model.HistoryEvents;
}

<section class="profile-shell group-page group-page--manage @Model.WallpaperCssClass">

    <div class="card group-manage-hero">
        <div class="group-manage-hero__copy">
            <span class="group-manage-hero__eyebrow">@Model.VisibilitySummary</span>
            <h1>@Model.Name</h1>

            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p>@Model.Description</p>
            }
            else
            {
                <p>This group is ready for shared cravings, quick coordination, and the next dinner plan.</p>
            }

            <div class="profile-meta">
                <span class="pill">@Model.Visibility</span>
                <span class="pill">@Model.ActiveMemberCount @(Model.ActiveMemberCount == 1 ? "member" : "members")</span>
                <span class="pill">@Model.LinkedEventCount linked @(Model.LinkedEventCount == 1 ? "event" : "events")</span>
                <span class="pill">@Model.AnnouncementCount @(Model.AnnouncementCount == 1 ? "announcement" : "announcements")</span>
            </div>

            <div class="group-manage-hero__stats" aria-label="Group overview">
                <div class="group-manage-hero__stat">
                    <span class="group-manage-hero__stat-label">Owner</span>
                    <strong>@(owner?.DisplayName ?? "Group owner")</strong>
                </div>
                <div class="group-manage-hero__stat">
                    <span class="group-manage-hero__stat-label">Membership</span>
                    <strong>@(Model.Visibility == "Private" ? "Invite only" : "Open join")</strong>
                </div>
                <div class="group-manage-hero__stat">
                    <span class="group-manage-hero__stat-label">Group chat</span>
                    <strong>@((Model.IsCurrentUserMember || Model.IsCurrentUserOwner) ? "Open" : "Locked")</strong>
                </div>
                <div class="group-manage-hero__stat">
                    <span class="group-manage-hero__stat-label">Theme</span>
                    <strong>@Model.WallpaperTheme</strong>
                </div>
            </div>

            <div class="group-note-list group-note-list--hero">
                <div class="group-note-list__item">
                    <span class="group-note-list__label">Visibility</span>
                    <strong>@Model.JoiningSummary</strong>
                </div>
                <div class="group-note-list__item">
                    <span class="group-note-list__label">Chat access</span>
                    <strong>Current active members only.</strong>
                </div>
            </div>

            <div class="group-manage-hero__board">
                <div class="group-section__header">
                    <div>
                        <p class="group-section__eyebrow">Announcements</p>
                        <h2>Community Board</h2>
                    </div>
                    <p class="card__subtitle">Owner posts and linked events for this group.</p>
                </div>

                @if (Model.IsCurrentUserOwner)
                {
                    <form asp-action="CreateAnnouncement" asp-route-groupId="@Model.GroupId" method="post" class="group-announcement-form group-announcement-form--hero group-announcement-form--vertical">
                        @Html.AntiForgeryToken()
                        <div class="field">
                            <label for="AnnouncementTitle">Post Title</label>
                            <input type="text" id="AnnouncementTitle" name="AnnouncementTitle" maxlength="120" placeholder="e.g. Friday ramen plan" />
                        </div>
                        <div class="field">
                            <label for="AnnouncementBody">Message</label>
                            <textarea id="AnnouncementBody" name="AnnouncementBody" maxlength="1000" placeholder="Write an update for the group..."></textarea>
                        </div>
                        <button type="submit" class="button button--primary">Post Announcement</button>
                    </form>
                }

                <div class="group-announcement-list group-announcement-list--hero">
                    @if (Model.Announcements.Count == 0)
                    {
                        <p class="empty-state">No announcements yet. New group events and owner posts will show here.</p>
                    }
                    else
                    {
                        @foreach (var announcement in Model.Announcements)
                        {
                            <article class="summary-card group-announcement-card">
                                <div class="group-announcement-card__meta">
                                    <span class="pill">@announcement.TypeLabel</span>
                                    <span>@announcement.CreatedLabel</span>
                                </div>
                                <h3>@announcement.Title</h3>
                                <p>@announcement.Body</p>
                                <div class="group-announcement-card__footer">
                                    <span>By @announcement.AuthorDisplayName (@@@announcement.AuthorUsername)</span>
                                    @if (announcement.RelatedEventId.HasValue)
                                    {
                                        <a asp-controller="Event"
                                           asp-action="EventDetails"
                                           asp-route-eventId="@announcement.RelatedEventId.Value"
                                           class="group-linked-event-action">Open event</a>
                                    }
                                </div>
                            </article>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="group-manage-hero__actions">
            <a asp-action="Index" class="button button--secondary">Back to Groups</a>

            @if (Model.IsCurrentUserOwner)
            {
                <a asp-controller="Event"
                   asp-action="CreateEvent"
                   asp-route-groupId="@Model.GroupId"
                   class="button button--primary">Create Group Event</a>
            }

            @if (Model.IsCurrentUserMember || Model.IsCurrentUserOwner)
            {
                <a asp-controller="Messaging"
                   asp-action="GroupChat"
                   asp-route-groupId="@Model.GroupId"
                   class="button button--secondary">Open Group Chat</a>
            }

            @if (Model.IsCurrentUserMember && !Model.IsCurrentUserOwner)
            {
                <form asp-action="Leave" asp-route-groupId="@Model.GroupId" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="button button--secondary"
                            onclick="return confirm('Leave this group?')">
                        Leave Group
                    </button>
                </form>
            }

            @if (!Model.IsCurrentUserMember && !Model.IsCurrentUserOwner)
            {
                <form asp-action="Join" asp-route-groupId="@Model.GroupId" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="button button--primary">Join Group</button>
                </form>
            }
        </div>
    </div>

    <div class="group-detail-layout">
        <div class="group-detail-layout__main">
            <section class="panel stack">
                <div class="group-section__header">
                    <div>
                        <p class="group-section__eyebrow">People</p>
                        <h2>Members</h2>
                    </div>
                    <p class="card__subtitle">See who is already in the room and what they are into before the next meetup.</p>
                </div>

                <div class="panel__items interest-card-list">
                    @if (Model.Members.Count == 0)
                    {
                        <p class="empty-state">No members yet.</p>
                    }
                    else
                    {
                        @foreach (var member in Model.Members)
                        {
                            <article class="summary-card interest-card interest-card--person">
                                <div class="interest-card__header">
                                    <button type="button"
                                            class="interest-card__avatar-trigger"
                                            onclick="openUserCard('@member.UserId')"
                                            aria-label="View @member.DisplayName's profile">
                                        <span class="interest-card__avatar-shell">
                                            @if (member.AvatarUrl is not null)
                                            {
                                                <img src="@member.AvatarUrl"
                                                     alt=""
                                                     class="interest-card__avatar-image"
                                                     loading="lazy" />
                                            }
                                            else
                                            {
                                                <span class="interest-card__avatar">@member.Initial</span>
                                            }
                                        </span>
                                    </button>

                                    <div class="interest-card__body">
                                        <button type="button"
                                                class="interest-card__identity interest-card__identity--button"
                                                onclick="openUserCard('@member.UserId')"
                                                aria-label="View @member.DisplayName's profile">
                                            <span class="interest-card__title">@member.DisplayName</span>
                                            <span class="interest-card__subtitle">@@@member.Username</span>
                                        </button>

                                        <div class="interest-card__chips">
                                            @if (member.PreviewFoodTags.Count == 0)
                                            {
                                                <span class="interest-card__chip interest-card__chip--muted">No public food preferences yet</span>
                                            }
                                            else
                                            {
                                                @foreach (var tag in member.PreviewFoodTags)
                                                {
                                                    <span class="interest-card__chip">@tag</span>
                                                }

                                                @if (member.HiddenFoodTagCount > 0)
                                                {
                                                    <span class="interest-card__chip interest-card__chip--muted">+@member.HiddenFoodTagCount more</span>
                                                }
                                            }
                                        </div>
                                    </div>

                                    <div class="interest-card__actions interest-card__actions--top">
                                        @if (member.IsOwner)
                                        {
                                            <span class="pill group-member-pill">Owner</span>
                                        }

                                        <button type="button"
                                                class="interest-card__icon-action"
                                                onclick="openUserCard('@member.UserId')"
                                                aria-label="Open @member.DisplayName's profile">
                                            ...
                                        </button>

                                        @if (Model.IsCurrentUserOwner && !member.IsOwner)
                                        {
                                            <form asp-action="RemoveMember"
                                                  asp-route-groupId="@Model.GroupId"
                                                  asp-route-userId="@member.UserId"
                                                  method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="interest-card__danger-action"
                                                        onclick="return confirm('Remove @member.DisplayName from the group?')">
                                                    Remove
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>

                                <div class="interest-card__facts">
                                    <span class="interest-card__fact">@member.RoleLabel</span>
                                    <span class="interest-card__fact">@member.JoinedLabel</span>
                                    @if (member.GoalLabel is not null)
                                    {
                                        <span class="interest-card__fact">@member.GoalLabel</span>
                                    }
                                    @if (member.ZipLabel is not null)
                                    {
                                        <span class="interest-card__fact">@member.ZipLabel</span>
                                    }
                                </div>
                            </article>
                        }
                    }
                </div>
            </section>

            <section class="panel stack">
                <div class="group-section__header">
                    <div>
                        <p class="group-section__eyebrow">Events</p>
                        <h2>Linked Events</h2>
                    </div>
                    <p class="card__subtitle">Planned events show upcoming group plans. History keeps completed and cancelled events with visible feedback.</p>
                </div>

                <div class="group-linked-event-tabs" role="tablist" aria-label="Linked event views">
                    <button type="button"
                            class="group-linked-event-tab is-active"
                            id="group-planned-events-tab"
                            role="tab"
                            aria-selected="true"
                            aria-controls="group-planned-events"
                            data-group-event-tab="planned">
                        Planned Events
                    </button>
                    <button type="button"
                            class="group-linked-event-tab"
                            id="group-history-events-tab"
                            role="tab"
                            aria-selected="false"
                            aria-controls="group-history-events"
                            data-group-event-tab="history">
                        History Events
                    </button>
                </div>

                <div id="group-planned-events"
                     class="group-event-history"
                     role="tabpanel"
                     aria-labelledby="group-planned-events-tab"
                     data-group-event-panel="planned">
                    @if (plannedEvents.Count == 0)
                    {
                        <p class="empty-state">No planned group events yet.</p>
                    }
                    else
                    {
                        @foreach (var groupEvent in plannedEvents)
                        {
                            <article class="summary-card group-event-card">
                                <div class="group-event-card__header">
                                    <div class="group-event-card__date">
                                        <span class="group-event-card__date-label">@groupEvent.EventDateLabel</span>
                                        <strong>@groupEvent.EventTimeLabel</strong>
                                    </div>

                                    <div class="group-event-card__content">
                                        <div class="group-event-card__heading">
                                            <h3>
                                                <a asp-controller="Event"
                                                   asp-action="EventDetails"
                                                   asp-route-eventId="@groupEvent.EventId">@groupEvent.Title</a>
                                            </h3>
                                            <div class="group-event-card__meta">
                                                <span class="pill group-event-card__pill group-event-card__pill--access">@groupEvent.EventAccessLabel</span>
                                                <span class="pill group-event-card__pill group-event-card__pill--status">@groupEvent.EventStatusLabel</span>
                                                <span class="pill">@groupEvent.ParticipationLabel</span>
                                                @if (!string.IsNullOrWhiteSpace(groupEvent.CuisineTarget))
                                                {
                                                    <span class="pill">@groupEvent.CuisineTarget</span>
                                                }
                                            </div>
                                            <a asp-controller="Event"
                                               asp-action="EventDetails"
                                               asp-route-eventId="@groupEvent.EventId"
                                               class="group-linked-event-action">View details</a>
                                        </div>
                                    </div>
                                </div>
                            </article>
                        }
                    }
                </div>

                <div id="group-history-events"
                     class="group-event-history"
                     role="tabpanel"
                     aria-labelledby="group-history-events-tab"
                     data-group-event-panel="history"
                     hidden>
                    @if (Model.EventHistory.Count == 0)
                    {
                        <p class="empty-state">No group events yet.</p>
                    }
                    else if (historyEvents.Count == 0)
                    {
                        <p class="empty-state">No history events yet.</p>
                    }
                    else
                    {
                        @foreach (var groupEvent in historyEvents)
                        {
                            <article class="summary-card group-event-card">
                                <div class="group-event-card__header">
                                    <div class="group-event-card__date">
                                        <span class="group-event-card__date-label">@groupEvent.EventDateLabel</span>
                                        <strong>@groupEvent.EventTimeLabel</strong>
                                    </div>

                                    <div class="group-event-card__content">
                                        <div class="group-event-card__heading">
                                            <h3>
                                                <a asp-controller="Event"
                                                   asp-action="EventDetails"
                                                   asp-route-eventId="@groupEvent.EventId">@groupEvent.Title</a>
                                            </h3>
                                            <div class="group-event-card__meta">
                                                <span class="pill group-event-card__pill group-event-card__pill--access">@groupEvent.EventAccessLabel</span>
                                                <span class="pill group-event-card__pill group-event-card__pill--status">@groupEvent.EventStatusLabel</span>
                                                <span class="pill">@groupEvent.ParticipationLabel</span>
                                                @if (!string.IsNullOrWhiteSpace(groupEvent.CuisineTarget))
                                                {
                                                    <span class="pill">@groupEvent.CuisineTarget</span>
                                                }
                                            </div>
                                            <a asp-controller="Event"
                                               asp-action="EventDetails"
                                               asp-route-eventId="@groupEvent.EventId"
                                               class="group-linked-event-action">View details</a>
                                        </div>

                                        <div class="group-event-card__feedback">
                                            <div class="group-event-card__feedback-header">
                                                <h4>Feedback</h4>
                                                @if (groupEvent.AverageRatingLabel is not null)
                                                {
                                                    <span class="group-event-card__rating">@groupEvent.AverageRatingLabel</span>
                                                }
                                            </div>

                                            @if (!groupEvent.IsCompleted)
                                            {
                                                @if (groupEvent.IsCancelled)
                                                {
                                                    <p class="empty-state">Feedback is unavailable for cancelled events.</p>
                                                }
                                                else
                                                {
                                                    <p class="empty-state">Feedback opens after the event is completed.</p>
                                                }
                                            }
                                            else if (groupEvent.Feedback.Count == 0)
                                            {
                                                <p class="empty-state">No feedback visible yet.</p>
                                            }
                                            else
                                            {
                                                <div class="group-event-card__feedback-list">
                                                    @foreach (var feedback in groupEvent.Feedback)
                                                    {
                                                        <div class="summary-card group-event-card__feedback-item">
                                                            <div class="group-event-card__feedback-meta">
                                                                <strong>@feedback.AuthorDisplayName</strong>
                                                                <span>@@@feedback.AuthorUsername</span>
                                                                <span>Rating: @feedback.Rating / 5</span>
                                                            </div>
                                                            <p>@feedback.Text</p>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </article>
                        }
                    }
                </div>
            </section>
        </div>

        <aside class="group-detail-layout__side">
            @if (Model.IsCurrentUserOwner && Model.Visibility == "Private")
            {
                <section class="panel stack">
                    <div class="group-section__header group-section__header--compact">
                        <div>
                            <p class="group-section__eyebrow">Invite</p>
                            <h2>Add a Member</h2>
                        </div>
                    </div>

                    <p class="card__subtitle">Private groups stay curated. Send invites by exact username.</p>

                    <form asp-action="Invite" asp-route-groupId="@Model.GroupId" method="post" class="stack">
                        @Html.AntiForgeryToken()
                        <div class="field">
                            <label for="InviteUsername">Username</label>
                            <input type="text"
                                   id="InviteUsername"
                                   name="InviteUsername"
                                   placeholder="e.g. foodlover42"
                                   autocomplete="off" />
                        </div>
                        <button type="submit" class="button button--primary">Send Invite</button>
                    </form>
                </section>
            }

            @if (Model.IsCurrentUserOwner)
            {
                <section class="panel stack">
                    <div class="group-section__header group-section__header--compact">
                        <div>
                            <p class="group-section__eyebrow">Owner Tools</p>
                            <h2>Group Settings</h2>
                        </div>
                    </div>

                    <p class="card__subtitle">Update the public face of the group without changing the underlying workflow.</p>

                    <form asp-action="UpdateSettings" asp-route-groupId="@Model.GroupId" method="post" class="stack">
                        @Html.AntiForgeryToken()

                        <div class="field">
                            <label for="EditName">Group Name</label>
                            <input type="text" id="EditName" name="EditName" value="@Model.EditName" />
                        </div>

                        <div class="field">
                            <label for="EditDescription">Description</label>
                            <textarea id="EditDescription" name="EditDescription">@Model.EditDescription</textarea>
                        </div>

                        <div class="field">
                            <label for="EditVisibility">Privacy</label>
                            <select id="EditVisibility" name="EditVisibility">
                                <option value="Public" selected="@(Model.EditVisibility?.ToString() == "Public" ? "selected" : null)">Public - anyone can join</option>
                                <option value="Private" selected="@(Model.EditVisibility?.ToString() == "Private" ? "selected" : null)">Private - invite only</option>
                            </select>
                        </div>

                        <div class="field">
                            <label for="EditWallpaperTheme">Food Background</label>
                            <select id="EditWallpaperTheme" name="EditWallpaperTheme">
                                @foreach (var option in Model.WallpaperOptions)
                                {
                                    <option value="@option.Value" selected="@(Model.EditWallpaperTheme == option.Value ? "selected" : null)">
                                        @option.Label - @option.Description
                                    </option>
                                }
                            </select>
                        </div>

                        <button type="submit" class="button button--primary">Save Settings</button>
                    </form>
                </section>
            }
        </aside>
    </div>

</section>

<script>
    document.querySelectorAll("[data-group-event-tab]").forEach(button => {
        button.addEventListener("click", () => {
            const selected = button.dataset.groupEventTab;

            document.querySelectorAll("[data-group-event-tab]").forEach(tab => {
                const isSelected = tab === button;
                tab.classList.toggle("is-active", isSelected);
                tab.setAttribute("aria-selected", isSelected ? "true" : "false");
            });

            document.querySelectorAll("[data-group-event-panel]").forEach(panel => {
                panel.hidden = panel.dataset.groupEventPanel !== selected;
            });
        });
    });
</script>
