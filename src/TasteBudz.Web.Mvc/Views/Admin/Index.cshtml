@model AdminIndexViewModel

@{
    ViewData["Title"] = "Admin Panel";
}

<div class="admin-shell">

    <div class="admin-header">
        <div>
            <span class="eyebrow">🛡️ Moderation</span>
            <h1 class="admin-title">Admin Panel</h1>
            <p class="admin-subtitle">Review reports, manage user restrictions, and maintain catalog data.</p>
        </div>
        <div class="button-row">
            <a asp-action="Reports" class="button button--secondary">
                All Reports
            </a>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Restaurants" class="button button--secondary">
                    Restaurant Catalog
                </a>
                <a asp-action="SupportThreads" class="button button--secondary">
                    Support Chats
                </a>
            }
        </div>
    </div>

    @if (User.IsInRole("Admin"))
    {
        <section class="admin-section">
            <div class="admin-section__header">
                <h2 class="admin-section__title">Password Reset</h2>
            </div>
            <p class="muted-note" style="margin-bottom:0.75rem;">
                Generate a one-time reset link for an active user. The user must choose a new password before signing in again.
            </p>
            <form asp-action="GeneratePasswordResetToken" method="post" class="stack" style="max-width: 620px;">
                @Html.AntiForgeryToken()
                <div class="field">
                    <label for="usernameOrEmail">Username or email</label>
                    <input id="usernameOrEmail" name="usernameOrEmail" maxlength="256" placeholder="alex or alex@example.com" required />
                </div>
                <div class="button-row">
                    <button type="submit" class="button button--primary">Generate Reset Link</button>
                </div>
            </form>

            @if (Model.GeneratedPasswordResetToken is not null)
            {
                <div class="summary-card" style="margin-top:1rem;">
                    <strong>Reset link for @Model.GeneratedPasswordResetToken.Username</strong>
                    <p class="muted-note">Expires @Model.GeneratedPasswordResetToken.ExpiresAtUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt").</p>
                    <div class="field" style="margin-top:0.75rem;">
                        <label for="resetUrl">Reset URL</label>
                        <input id="resetUrl" value="@Model.GeneratedPasswordResetToken.ResetUrl" readonly />
                    </div>
                    <div class="field" style="margin-top:0.75rem;">
                        <label for="resetToken">Token</label>
                        <input id="resetToken" value="@Model.GeneratedPasswordResetToken.ResetToken" readonly />
                    </div>
                </div>
            }

            @if (!Model.OpenPasswordResetRequests.Any())
            {
                <p class="muted-note" style="margin-top:1rem;">No open password reset requests.</p>
            }
            else
            {
                <div class="report-list" style="margin-top:1rem;">
                    @foreach (var request in Model.OpenPasswordResetRequests)
                    {
                        <article class="report-card card">
                            <div class="report-card__header">
                                <div>
                                    <strong>@request.Username</strong>
                                    <p class="muted-note">@request.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</p>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(request.MatchedUsername))
                                {
                                    <span class="pill">Matched @request.MatchedUsername</span>
                                }
                                else
                                {
                                    <span class="pill">No active match</span>
                                }
                            </div>

                            <p class="report-card__reason">@request.Message</p>

                            <div class="button-row">
                                @if (!string.IsNullOrWhiteSpace(request.MatchedUsername))
                                {
                                    <form asp-action="GeneratePasswordResetToken" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="passwordResetRequestId" value="@request.RequestId" />
                                        <input type="hidden" name="usernameOrEmail" value="@request.MatchedUsername" />
                                        <button type="submit" class="button button--primary">Generate Reset Link</button>
                                    </form>
                                }
                                <form asp-action="DismissPasswordResetRequest" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="requestId" value="@request.RequestId" />
                                    <button type="submit" class="button button--secondary">Dismiss</button>
                                </form>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

        <section class="admin-section">
            <div class="admin-section__header">
                <h2 class="admin-section__title">Restaurant Catalog</h2>
            </div>
            <p class="muted-note" style="margin-bottom:0.75rem;">
                Use the paginated catalog page to preview OpenStreetMap candidates, import selected restaurants, and avoid duplicates.
            </p>
            <a asp-action="Restaurants" class="button button--primary">Open Restaurant Catalog</a>
        </section>

        <section class="admin-section">
            <div class="admin-section__header">
                <h2 class="admin-section__title">Restaurant Admin Assignments</h2>
            </div>

            @if (!Model.RestaurantOperationsAvailable)
            {
                <p class="muted-note">Restaurant operations are not enabled.</p>
            }
            else
            {
                <div class="summary-card">
                    <strong>@Model.RestaurantCatalogTotalCount restaurant catalog entries</strong>
                    <p class="muted-note">Use the paginated catalog page to edit restaurants and manage restaurant-admin assignments.</p>
                    <div class="button-row">
                        <a asp-action="Restaurants" class="button button--primary">Open Restaurant Catalog</a>
                    </div>
                </div>
            }
        </section>
    }

    <!-- Pending Reports -->
    <section class="admin-section">
        <div class="admin-section__header">
            <h2 class="admin-section__title">
                Pending Reports
                @if (Model.PendingReports.Count > 0)
                {
                    <span class="admin-badge admin-badge--warn">@Model.PendingReports.Count</span>
                }
            </h2>
        </div>

        @if (!Model.PendingReports.Any())
        {
            <div class="admin-empty">
                <span class="admin-empty__icon">✅</span>
                <p>No pending reports. Everything looks clean!</p>
            </div>
        }
        else
        {
            <div class="report-list">
                @foreach (var report in Model.PendingReports)
                {
                    <div class="report-card card">
                        <div class="report-card__header">
                            <div class="report-card__meta">
                                <span class="report-card__type">@report.TargetType</span>
                                <span class="report-card__category pill">@report.Category</span>
                            </div>
                            <time class="report-card__time" datetime="@report.CreatedAtUtc.ToString("o")">
                                @report.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                            </time>
                        </div>

                        <p class="report-card__reason">@report.Reason</p>

                        @if (!string.IsNullOrWhiteSpace(report.Explanation))
                        {
                            <p class="report-card__explanation muted-note">@report.Explanation</p>
                        }

                        <div class="report-card__footer">
                            <div class="report-card__ids">
                                <span class="muted-note">Reporter: <code>@report.ReporterUserId.ToString()[..8]…</code></span>
                                @if (report.RelatedUserId.HasValue)
                                {
                                    <span class="muted-note">Reported user: <code>@report.RelatedUserId.Value.ToString()[..8]…</code></span>
                                }
                            </div>
                            <div class="button-row">
                                <a asp-action="ReportDetail" asp-route-id="@report.ReportId" class="button button--secondary">
                                    View Details
                                </a>
                                @if (report.RelatedUserId.HasValue)
                                {
                                    <button class="button button--danger"
                                            onclick="openBanModal('@report.RelatedUserId', '@report.ReportId')">
                                        Ban User
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
</div>

<!-- Ban confirmation modal -->
<div class="ban-overlay" id="banOverlay" hidden>
    <div class="ban-modal card">
        <button class="ban-modal__close" onclick="closeBanModal()" aria-label="Close">✕</button>
        <h2 class="card__title">Ban User</h2>
        <p class="card__subtitle">Choose the restriction duration. This action is logged.</p>
        <form asp-action="BanUser" method="post" class="stack" id="banForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="userId" id="banUserId" />
            <input type="hidden" name="reportId" id="banReportId" />
            <div class="field">
                <label for="banReason">Reason</label>
                <textarea id="banReason" name="reason" placeholder="Brief reason for this restriction…" required></textarea>
            </div>
            <div class="ban-duration-row">
                <button type="submit" name="permanent" value="false" class="button button--primary ban-btn">
                    🕐 7-Day Ban
                </button>
                <button type="submit" name="permanent" value="true" class="button button--danger ban-btn">
                    🚫 Permanent Ban
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openBanModal(userId, reportId) {
            document.getElementById('banUserId').value = userId;
            document.getElementById('banReportId').value = reportId;
            document.getElementById('banOverlay').removeAttribute('hidden');
        }
        function closeBanModal() {
            document.getElementById('banOverlay').setAttribute('hidden', '');
            document.getElementById('banReason').value = '';
        }
        document.getElementById('banOverlay').addEventListener('click', function (e) {
            if (e.target === this) closeBanModal();
        });
    </script>
}
