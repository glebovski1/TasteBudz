@model GroupIndexViewModel

@{
    ViewData["Title"] = "Groups";

    var heroTitle = string.IsNullOrWhiteSpace(Model.SearchQuery)
        ? "Find your dinner crowd."
        : $"Results for \"{Model.SearchQuery}\"";
    var heroCopy = string.IsNullOrWhiteSpace(Model.SearchQuery)
        ? "Browse public communities, spot the vibe fast, and join the groups already planning their next meal."
        : "Refine the search or open one of the matching groups to see members, chat, and linked events.";
}

<section class="profile-shell group-page">

    <div class="card group-discovery-hero">
        <div class="group-discovery-hero__copy">
            <span class="group-discovery-hero__eyebrow">TasteBudz Groups</span>
            <h1>@heroTitle</h1>
            <p>@heroCopy</p>

            <div class="group-discovery-hero__stats" aria-label="Group browse highlights">
                <div class="group-discovery-hero__stat">
                    <strong>@Model.TotalCount</strong>
                    <span>public groups in this view</span>
                </div>
                <div class="group-discovery-hero__stat">
                    <strong>@Model.TotalMembers</strong>
                    <span>members across the current results</span>
                </div>
                <div class="group-discovery-hero__stat">
                    <strong>@(Model.LargestGroupSize == 0 ? "--" : Model.LargestGroupSize)</strong>
                    <span>largest visible group</span>
                </div>
            </div>
        </div>

        <div class="group-discovery-hero__actions">
            <div class="button-row group-discovery-hero__action-row">
                <a asp-action="CreateGroup" class="button button--primary">Create Group</a>
                <a asp-controller="Messaging" asp-action="Chat" class="button button--secondary">Open Chats</a>
            </div>

            <form asp-action="Index" method="get" class="group-search-panel">
                <label for="GroupSearchQuery" class="sr-only">Search groups by name</label>
                <div class="group-search-panel__row">
                    <input type="text"
                           id="GroupSearchQuery"
                           name="q"
                           value="@Model.SearchQuery"
                           placeholder="Search groups by name..."
                           autocomplete="off" />
                    <button type="submit" class="button button--primary">Search</button>
                </div>

                <div class="group-search-panel__footer">
                    <p class="group-search-panel__summary">
                        @if (string.IsNullOrWhiteSpace(Model.SearchQuery))
                        {
                            <span>Browse the public side of TasteBudz. Private groups stay invite-only in MVP.</span>
                        }
                        else
                        {
                            <span>Showing @Model.Groups.Count match@(Model.Groups.Count == 1 ? string.Empty : "es") for "@Model.SearchQuery".</span>
                        }
                    </p>

                    @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                    {
                        <a asp-action="Index" class="button button--secondary button--small">Clear Search</a>
                    }
                </div>
            </form>
        </div>
    </div>

    @if (Model.MyGroups.Count > 0)
    {
        <section class="panel stack group-my-groups">
            <div class="group-section__header">
                <div>
                    <p class="group-section__eyebrow">My Groups</p>
                    <h2>Your dinner circles</h2>
                </div>
                <p class="card__subtitle">
                    Private groups only appear here for current members.
                    @if (Model.PrivateMyGroupCount > 0)
                    {
                        <span>@Model.PrivateMyGroupCount private @(Model.PrivateMyGroupCount == 1 ? "group is" : "groups are") visible to you.</span>
                    }
                </p>
            </div>

            <div class="panel__items interest-card-list group-my-groups__list">
                @foreach (var group in Model.MyGroups)
                {
                    <article class="summary-card interest-card group-my-card">
                        <div class="interest-card__header">
                            <span class="interest-card__avatar-shell" aria-hidden="true">
                                <span class="interest-card__avatar">@group.Initial</span>
                            </span>

                            <div class="interest-card__body">
                                <a asp-action="Manage"
                                   asp-route-groupId="@group.GroupId"
                                   class="interest-card__identity interest-card__identity--button"
                                   aria-label="Open @group.Name">
                                    <span class="interest-card__title">@group.Name</span>
                                    <span class="interest-card__subtitle">@group.DescriptionPreview</span>
                                </a>

                                <div class="interest-card__chips">
                                    <span class="interest-card__chip">@group.VisibilityLabel</span>
                                    <span class="interest-card__chip">@group.MemberLabel</span>
                                    <span class="interest-card__chip interest-card__chip--muted">@group.AccessLabel</span>
                                </div>
                            </div>

                            <div class="interest-card__actions interest-card__actions--top">
                                <a asp-action="Manage"
                                   asp-route-groupId="@group.GroupId"
                                   class="interest-card__icon-action"
                                   aria-label="Open @group.Name">
                                    Open
                                </a>
                                <a asp-controller="Messaging"
                                   asp-action="GroupChat"
                                   asp-route-groupId="@group.GroupId"
                                   class="interest-card__icon-action"
                                   aria-label="Open @group.Name chat">
                                    Chat
                                </a>
                            </div>
                        </div>
                    </article>
                }
            </div>
        </section>
    }

    @if (Model.Groups.Count == 0)
    {
        <div class="panel group-empty-state">
            <p class="group-empty-state__eyebrow">No groups to show</p>
            <h2 class="group-empty-state__title">
                @if (string.IsNullOrWhiteSpace(Model.SearchQuery))
                {
                    <span>Start the first dinner circle.</span>
                }
                else
                {
                    <span>No groups matched "@Model.SearchQuery".</span>
                }
            </h2>
            <p class="group-empty-state__copy">
                @if (string.IsNullOrWhiteSpace(Model.SearchQuery))
                {
                    <span>Create a public group for neighborhood dinners or a private one for a curated crew.</span>
                }
                else
                {
                    <span>Try a broader name, or create a new group and define the vibe yourself.</span>
                }
            </p>

            <div class="button-row">
                <a asp-action="CreateGroup" class="button button--primary">Create Group</a>
                @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                {
                    <a asp-action="Index" class="button button--secondary">Browse All</a>
                }
            </div>
        </div>
    }
    else
    {
        <div class="groups-grid groups-grid--public">
            @foreach (var item in Model.Groups.Select((group, index) => new { Group = group, Index = index }))
            {
                var group = item.Group;

                <article class="summary-card interest-card group-public-card group-showcase-card--tone-@(item.Index % 4)">
                    <div class="interest-card__header">
                        <span class="interest-card__avatar-shell group-public-card__avatar" aria-hidden="true">
                            <span class="interest-card__avatar">@group.Monogram</span>
                        </span>

                        <div class="interest-card__body">
                            <a asp-action="Manage"
                               asp-route-groupId="@group.GroupId"
                               class="interest-card__identity interest-card__identity--button"
                               aria-label="Open @group.Name">
                                <span class="interest-card__title">@group.Name</span>
                                <span class="interest-card__subtitle">@group.DescriptionPreview</span>
                            </a>

                            <p class="group-public-card__support">@group.BrowseSupportText</p>

                            <div class="interest-card__chips">
                                <span class="interest-card__chip">@group.Visibility</span>
                                <span class="interest-card__chip">@group.MemberLabel</span>
                                <span class="interest-card__chip interest-card__chip--muted">@group.VisibilitySummary</span>
                            </div>
                        </div>

                        <div class="interest-card__actions interest-card__actions--top group-public-card__actions">
                            <a asp-action="Manage"
                               asp-route-groupId="@group.GroupId"
                               class="interest-card__text-action"
                               aria-label="View details for @group.Name">
                                View Details
                            </a>
                        </div>
                    </div>
                </article>
            }
        </div>
    }

</section>
