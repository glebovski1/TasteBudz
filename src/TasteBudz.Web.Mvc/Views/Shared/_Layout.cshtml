<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TasteBudz</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="page-backdrop"></div>
    <header class="tb-header">
        <div class="header__inner">
            <a class="site-brand" asp-controller="Account" asp-action="Login">
                <span class="site-brand__mark">TB</span>
                <span>
                    <strong>TasteBudz</strong>
                </span>
            </a>

            @* Hamburger button - only visible on mobile via CSS *@
            <button class="nav-toggle"
                    id="navToggle"
                    aria-controls="primaryNav"
                    aria-expanded="false"
                    aria-label="Open navigation menu">
                <span class="nav-toggle__bar"></span>
                <span class="nav-toggle__bar"></span>
                <span class="nav-toggle__bar"></span>
            </button>

            <nav class="tb-nav" id="primaryNav" aria-label="Primary">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Profile" asp-action="View">Dashboard</a>
                    <a asp-controller="Discovery" asp-action="Swipe">Find Budz</a>
                    <a asp-controller="Group" asp-action="Index">Groups</a>
                    <a asp-controller="Event" asp-action="Index">Events</a>
                    <a asp-controller="Messaging" asp-action="Support">Support</a>
                    @if (User.IsInRole("RestaurantAdmin"))
                    {
                        <a asp-controller="RestaurantAdmin" asp-action="Index">Manage Restaurants</a>
                    }
                    <partial name="_NotificationBell" />
                    <button type="button" class="tb-nav-logout" onclick="confirmLogout()">Log Out</button>
                }
                else
                {
                    <a asp-controller="Home" asp-action="Index">Home</a>
                    <a asp-controller="Account" asp-action="Login" class="tb-nav-login">Log In</a>
                    <a asp-controller="Account" asp-action="CreateAccount">Create Account</a>
                }
                @if (User.IsInRole("Admin") || User.IsInRole("Moderator"))
                {
                    <a asp-controller="Admin" asp-action="Index">Admin</a>
                }
            </nav>

            @* Hidden logout form - submitted by JS after confirmation *@
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form id="logoutForm" asp-controller="Account" asp-action="Logout" method="post" style="display:none;">
                    @Html.AntiForgeryToken()
                </form>
            }
        </div>
    </header>

    <main class="page-shell">
        @if (TempData["StatusMessage"] is string statusMessage)
        {
            <div class="flash-message" role="status">@statusMessage</div>
        }

        @RenderBody()

        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Messaging" asp-action="Support" class="floating-btn floating-btn--support" aria-label="Open support">
                Help
            </a>
            <a asp-controller="Messaging" asp-action="Chat" class="floating-btn" aria-label="Open chats">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                </svg>
            </a>
        }
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <partial name="_UserCardModal" />

    <script>
        // Hamburger toggle
        (function () {
        var btn = document.getElementById('navToggle');
        var nav = document.getElementById('primaryNav');
        if (!btn || !nav) return;

        btn.addEventListener('click', function () {
        var open = nav.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        });

        // Close menu when a nav link is clicked
        nav.querySelectorAll('a, button').forEach(function (el) {
        el.addEventListener('click', function () {
        if (el.closest('.notif-bell')) return;
        nav.classList.remove('is-open');
        btn.setAttribute('aria-expanded', 'false');
        });
        });

        // Close menu when clicking outside
        document.addEventListener('click', function (e) {
        if (!nav.contains(e.target) && !btn.contains(e.target)) {
        nav.classList.remove('is-open');
        btn.setAttribute('aria-expanded', 'false');
        }
        });
        }());

        function confirmLogout() {
        if (confirm("Are you sure you want to log out?")) {
        document.getElementById("logoutForm").submit();
        }
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
