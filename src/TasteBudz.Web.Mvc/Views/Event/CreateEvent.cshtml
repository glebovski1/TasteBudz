@model EventCreateViewModel

@{
    ViewData["Title"] = "Create Event";

    // Serialize restaurant data for the map JS — only include those with coordinates
    var mapRestaurants = Model.Restaurants
        .Where(r => r.Latitude.HasValue && r.Longitude.HasValue)
        .Select(r => new
        {
            id = r.RestaurantId,
            name = r.Name,
            location = r.Location,
            priceTier = r.PriceTier,
            cuisine = r.CuisineTags,
            lat = r.Latitude!.Value,
            lng = r.Longitude!.Value,
            googleMapsUrl = r.GoogleMapsUrl,
        });
    var mapJson = System.Text.Json.JsonSerializer.Serialize(mapRestaurants);

    var allCuisines = EventCreateViewModel.AvailableCuisineTags;
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<section class="profile-shell">

    <div class="card profile-banner" style="grid-template-columns: 1fr auto;">
        <div>
            <h1>@(Model.IsGroupEvent ? "Create Group Event" : "Create Event")</h1>
            @if (Model.IsGroupEvent)
            {
                <p>Plan a dining event for @(string.IsNullOrWhiteSpace(Model.GroupName) ? "this group" : Model.GroupName).</p>
            }
            else
            {
                <p>Set up a food event and invite others to join.</p>
            }
        </div>
        <div class="button-row">
            @if (Model.IsGroupEvent)
            {
                <a asp-controller="Group"
                   asp-action="Manage"
                   asp-route-groupId="@Model.GroupId"
                   class="button button--secondary">Back to Group</a>
            }
            else
            {
                <a asp-action="Index" class="button button--secondary">Back to Events</a>
            }
        </div>
    </div>

    <form asp-action="CreateEvent" method="post" class="stack-lg" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="GroupId" />
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <div class="editor-grid">

            <section class="card stack" style="grid-column: 1 / -1;">
                <div>
                    <h2 class="card__title">Event Details</h2>
                    <p class="card__subtitle">Give your event a name and choose a cuisine theme.</p>
                </div>
                <div class="editor-grid" style="gap: 1rem;">
                    <div class="field">
                        <label asp-for="Title"></label>
                        <input asp-for="Title" placeholder="e.g. Sushi Night, Taco Tuesday…" />
                        <span asp-validation-for="Title" class="field-validation-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="CuisineTarget"></label>
                        <select asp-for="CuisineTarget">
                            <option value="">Any cuisine (optional)</option>
                            @foreach (var c in EventCreateViewModel.AvailableCuisineTags)
                            {
                                <option value="@c">@c</option>
                            }
                        </select>
                        <span asp-validation-for="CuisineTarget" class="field-validation-error"></span>
                    </div>
                </div>
            </section>

            <section class="panel stack">
                <div>
                    <h2>Type &amp; Capacity</h2>
                    <p class="card__subtitle">
                        @(Model.IsGroupEvent ? Model.GroupEventTypeNotice : "Open events are public. Closed events are invite-only.")
                    </p>
                </div>
                @if (Model.HasForcedEventType)
                {
                    <input type="hidden" asp-for="EventType" />
                    <div class="event-type-lock" aria-label="Locked event type">
                        <span class="event-type-lock__label">Event Type</span>
                        <strong>@Model.ForcedEventTypeLabel</strong>
                        <span>@Model.GroupEventTypeNotice</span>
                    </div>
                }
                else
                {
                    <div class="field">
                        <label asp-for="EventType"></label>
                        <select asp-for="EventType">
                            <option value="">Select type...</option>
                            <option value="Open">Open - anyone can join</option>
                            <option value="Closed">Closed - invite only</option>
                        </select>
                        <span asp-validation-for="EventType" class="field-validation-error"></span>
                    </div>
                }
                <div class="field">
                    <label asp-for="Capacity"></label>
                    <input asp-for="Capacity" type="number" min="2" max="8" placeholder="2–8 people" />
                    <span asp-validation-for="Capacity" class="field-validation-error"></span>
                </div>
            </section>

            <section class="card stack">
                <div>
                    <h2 class="card__title">Date &amp; Time</h2>
                    <p class="card__subtitle">When is the event taking place?</p>
                </div>
                <div class="field">
                    <label asp-for="EventStartAt"></label>
                    <input asp-for="EventStartAt"
                           type="datetime-local"
                           min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                    <span asp-validation-for="EventStartAt" class="field-validation-error"></span>
                </div>
            </section>

            @* ── Restaurant picker ── *@
            <section class="card stack" style="grid-column: 1 / -1;">
                <div>
                    <h2 class="card__title">Restaurant <span class="muted-note">(optional)</span></h2>
                    <p class="card__subtitle">Filter the map to find a restaurant, then click a pin to select it. Pins load only for the current map area once you zoom in.</p>
                </div>

                <input type="hidden" asp-for="SelectedRestaurantId" id="selectedRestaurantId" />

                @if (!Model.Restaurants.Any(r => r.Latitude.HasValue && r.Longitude.HasValue))
                {
                    <p class="empty-state">No restaurants with location data available. Try importing from the Admin panel.</p>
                }
                else
                {
                    @* ── Filter bar ── *@
                    <div class="restaurant-filters" style="grid-template-columns: 1fr 1fr 1fr auto auto;">

                        <div class="field" style="margin:0;">
                            <label for="filterName">Search by name</label>
                            <input id="filterName" type="text" placeholder="e.g. Pizza…" autocomplete="off" />
                        </div>

                        <div class="field" style="margin:0;">
                            <label for="filterCuisine">Cuisine</label>
                            <select id="filterCuisine">
                                <option value="">All cuisines</option>
                                @foreach (var c in allCuisines)
                                {
                                    <option value="@c" selected="@(c.Equals(Model.CuisineTarget, StringComparison.OrdinalIgnoreCase))">@c</option>
                                }
                            </select>
                        </div>

                        <div class="field" style="margin:0;">
                            <label for="filterPrice">Price</label>
                            <select id="filterPrice">
                                <option value="">Any price</option>
                                <option value="$">$ — Budget</option>
                                <option value="$$">$$ — Moderate</option>
                                <option value="$$$">$$$ — Upscale</option>
                                <option value="$$$$">$$$$ — Fine dining</option>
                            </select>
                        </div>

                        <div class="field" style="margin:0;">
                            <label for="filterDistance">Max distance</label>
                            <select id="filterDistance">
                                <option value="">Any distance</option>
                                <option value="1">Within 1 mile</option>
                                <option value="3">Within 3 miles</option>
                                <option value="5">Within 5 miles</option>
                                <option value="10">Within 10 miles</option>
                                <option value="25">Within 25 miles</option>
                            </select>
                        </div>

                        <button type="button" id="clearFilters"
                                class="button button--secondary"
                                style="align-self:end; display:none;">
                            Clear filters
                        </button>
                    </div>

                    @* ── Results count ── *@
                    <p id="filterCount" class="muted-note" style="margin:0;"></p>

                    @* ── Randomizer ── *@
                    <div class="randomizer-bar">
                        <button type="button" id="randomBtn" class="button button--primary">
                            🎲 Surprise Me!
                        </button>
                        <div class="randomizer-result" id="randomizerResult" hidden>
                            <span class="randomizer-result__icon">🍽️</span>
                            <div class="randomizer-result__info">
                                <strong id="randName"></strong>
                                <span id="randMeta"></span>
                            </div>
                            <button type="button" class="button button--secondary button--sm" id="randPickAnother">
                                Pick another
                            </button>
                            <button type="button" class="button button--primary button--sm" id="randConfirm">
                                Use this one
                            </button>
                        </div>
                    </div>

                    @* ── Map ── *@
                    <div id="restaurantMap" class="restaurant-map"></div>

                    @* ── Selection bar ── *@
                    <div class="restaurant-selection-bar" id="selectionBar">
                        <span id="selectionLabel">No restaurant selected.</span>
                        <button type="button" class="button button--secondary button--sm" id="clearSelection" style="display:none;">
                            Clear
                        </button>
                    </div>
                }
            </section>

        </div>

        <div class="button-row">
            <button type="submit" class="button button--primary">@(Model.IsGroupEvent ? "Create Group Event" : "Create Event")</button>
            @if (Model.IsGroupEvent)
            {
                <a asp-controller="Group"
                   asp-action="Manage"
                   asp-route-groupId="@Model.GroupId"
                   class="button button--secondary">Cancel</a>
            }
            else
            {
                <a asp-action="Index" class="button button--secondary">Cancel</a>
            }
        </div>

    </form>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        (function () {
        const restaurants = @Html.Raw(mapJson);
        const hiddenId    = document.getElementById("selectedRestaurantId");
        const cuisineTarget = document.getElementById("CuisineTarget");
        const label       = document.getElementById("selectionLabel");
        const clearBtn    = document.getElementById("clearSelection");
        const mapEl       = document.getElementById("restaurantMap");
        const filterName     = document.getElementById("filterName");
        const filterCuisine  = document.getElementById("filterCuisine");
        const filterPrice    = document.getElementById("filterPrice");
        const filterDistance = document.getElementById("filterDistance");
        const clearFilters   = document.getElementById("clearFilters");
        const filterCount    = document.getElementById("filterCount");

        const randomBtn       = document.getElementById("randomBtn");
        const randomizerResult = document.getElementById("randomizerResult");
        const randName        = document.getElementById("randName");
        const randMeta        = document.getElementById("randMeta");
        const randPickAnother = document.getElementById("randPickAnother");
        const randConfirm     = document.getElementById("randConfirm");
        const markerZoomThreshold = 13;

        if (!mapEl || restaurants.length === 0) return;

        // ── Map setup ────────────────────────────────────────────────────────

        const avgLat = restaurants.reduce((s, r) => s + r.lat, 0) / restaurants.length;
        const avgLng = restaurants.reduce((s, r) => s + r.lng, 0) / restaurants.length;

        const map = L.map("restaurantMap").setView([avgLat, avgLng], 13);

        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        maxZoom: 19,
        }).addTo(map);

        // ── Marker icons ─────────────────────────────────────────────────────

        const defaultIcon = L.divIcon({
        className: "map-pin",
        html: "🍽️",
        iconSize: [28, 28],
        iconAnchor: [14, 28],
        popupAnchor: [0, -28],
        });

        const selectedIcon = L.divIcon({
        className: "map-pin map-pin--selected",
        html: "📍",
        iconSize: [32, 32],
        iconAnchor: [16, 32],
        popupAnchor: [0, -32],
        });

        // ── Build markers ────────────────────────────────────────────────────

        const markerEntries = restaurants.map(r => ({
        data: r,
        marker: null,
        matchesFilters: true,
        isRendered: false,
        }));

        function ensureMarker(entry) {
        if (entry.marker) return entry.marker;

        const marker = L.marker([entry.data.lat, entry.data.lng], { icon: defaultIcon })
        .bindPopup(createRestaurantPopup(entry.data));

        marker.on("click", () => map.setView([entry.data.lat, entry.data.lng], Math.max(map.getZoom(), 15)));
        entry.marker = marker;
        return marker;
        }

        function clearSelection() {
        hiddenId.value = "";
        label.textContent = "No restaurant selected.";
        clearBtn.style.display = "none";
        updateMarkerIcons();
        }

        function updateMarkerIcons() {
        const selectedId = hiddenId.value;

        markerEntries.forEach(entry => {
        if (!entry.isRendered) return;
        const marker = ensureMarker(entry);
        marker.setIcon(entry.data.id === selectedId ? selectedIcon : defaultIcon);
        });
        }

        function syncMarkerRendering() {
        const zoom = map.getZoom();
        const zoomAllowsMarkers = zoom >= markerZoomThreshold;
        const bounds = map.getBounds();
        let rendered = 0;

        markerEntries.forEach(entry => {
        const shouldRender = zoomAllowsMarkers &&
        entry.matchesFilters &&
        bounds.contains([entry.data.lat, entry.data.lng]);

        entry.isRendered = shouldRender;

        if (shouldRender) {
        rendered++;
        const marker = ensureMarker(entry);
        if (!map.hasLayer(marker)) marker.addTo(map);
        } else if (entry.marker && map.hasLayer(entry.marker)) {
        entry.marker.closePopup();
        map.removeLayer(entry.marker);
        }
        });

        updateMarkerIcons();
        return { rendered, zoomAllowsMarkers };
        }

        function updateFilterCount(hasFilter) {
        const { rendered, zoomAllowsMarkers } = syncMarkerRendering();
        const matching = markerEntries.filter(entry => entry.matchesFilters).length;

        if (!filterCount) return;

        if (!zoomAllowsMarkers) {
        filterCount.textContent = `Zoom in to level ${markerZoomThreshold} or closer to load restaurant pins for the current map area.`;
        return;
        }

        const isViewportLimited = rendered < matching;
        if (!hasFilter && !isViewportLimited) {
        filterCount.textContent = `Showing ${rendered} restaurants in the current map area.`;
        return;
        }

        const parts = [`Showing ${rendered} pins in the current map area`];
        if (hasFilter || matching !== restaurants.length) {
        parts.push(`${matching} filter matches`);
        }

        filterCount.textContent = parts.join(" · ");
        }

        map.on("moveend zoomend", () => {
        const hasFilter = Boolean(
        (filterName?.value ?? "").trim() ||
        (filterCuisine?.value ?? "") ||
        (filterPrice?.value ?? "") ||
        (filterDistance?.value ?? ""));

        updateFilterCount(hasFilter);
        });

        function selectRestaurant(id, name) {
        hiddenId.value = id;
        label.textContent = "Selected: " + name;
        clearBtn.style.display = "inline-block";
        if (cuisineTarget) cuisineTarget.value = "";
        updateMarkerIcons();
        }

        function createRestaurantPopup(restaurant) {
        const container = document.createElement("div");

        const name = document.createElement("strong");
        name.textContent = restaurant.name;
        container.appendChild(name);
        container.appendChild(document.createElement("br"));

        container.appendChild(document.createTextNode(restaurant.location));
        container.appendChild(document.createElement("br"));

        const meta = document.createElement("span");
        meta.style.color = "#888";
        meta.textContent = restaurant.priceTier + " · " + restaurant.cuisine;
        container.appendChild(meta);
        container.appendChild(document.createElement("br"));

        const selectButton = document.createElement("button");
        selectButton.type = "button";
        selectButton.textContent = "Select";
        selectButton.style.marginTop = "6px";
        selectButton.style.padding = "4px 10px";
        selectButton.style.background = "#e05a2b";
        selectButton.style.color = "#fff";
        selectButton.style.border = "none";
        selectButton.style.borderRadius = "4px";
        selectButton.style.cursor = "pointer";
        selectButton.addEventListener("click", () => selectRestaurant(restaurant.id, restaurant.name));
        container.appendChild(selectButton);
        container.appendChild(document.createElement("br"));

        const mapsLink = document.createElement("a");
        mapsLink.href = restaurant.googleMapsUrl;
        mapsLink.target = "_blank";
        mapsLink.rel = "noopener noreferrer";
        mapsLink.textContent = "Open in Google Maps";
        mapsLink.style.display = "inline-block";
        mapsLink.style.marginTop = "6px";
        mapsLink.style.color = "#e05a2b";
        mapsLink.style.fontWeight = "700";
        container.appendChild(mapsLink);

        return container;
        }

        clearBtn.addEventListener("click", () => {
        clearSelection();
        });

        cuisineTarget?.addEventListener("change", () => {
        if (!cuisineTarget.value) return;
        clearSelection();
        });

        // ── Filtering ────────────────────────────────────────────────────────

        function applyFilters() {
        const nameQ     = (filterName?.value     ?? "").trim().toLowerCase();
        const cuisineQ  = (filterCuisine?.value  ?? "").toLowerCase();
        const priceQ    = (filterPrice?.value    ?? "");
        const distanceQ = filterDistance?.value ? parseFloat(filterDistance.value) : null;
        const hasFilter = nameQ || cuisineQ || priceQ || distanceQ;

        if (clearFilters) clearFilters.style.display = hasFilter ? "inline-block" : "none";

        const selectedId = hiddenId.value;

        markerEntries.forEach(entry => {
        const r = entry.data;
        const cuisineStr = (r.cuisine ?? "").toLowerCase();
        const priceStr   = (r.priceTier ?? "");

        const matchName    = !nameQ      || r.name.toLowerCase().includes(nameQ);
        const matchCuisine = !cuisineQ   || cuisineStr.split(",").map(s => s.trim()).includes(cuisineQ);
        const matchPrice   = !priceQ     || priceStr === priceQ;
        const matchDist    = !distanceQ  || (r._distance !== null && r._distance <= distanceQ);
        entry.matchesFilters = matchName && matchCuisine && matchPrice && matchDist;
        });

        if (selectedId) {
        const selectedEntry = markerEntries.find(entry => entry.data.id === selectedId);
        if (selectedEntry && !selectedEntry.matchesFilters) {
        clearSelection();
        }
        }

        updateFilterCount(hasFilter);
        }

        filterName?.addEventListener("input", applyFilters);
        filterCuisine?.addEventListener("change", applyFilters);
        filterPrice?.addEventListener("change", applyFilters);
        filterDistance?.addEventListener("change", applyFilters);

        clearFilters?.addEventListener("click", () => {
        if (filterName)     filterName.value     = "";
        if (filterCuisine)  filterCuisine.value  = "";
        if (filterPrice)    filterPrice.value    = "";
        if (filterDistance) filterDistance.value = "";
        applyFilters();
        });

        // ── Distance calculation ─────────────────────────────────────────────
        // Compute each marker's distance from the map centre so the distance
        // filter and randomizer can use it without re-querying the server.

        function haversineMiles(lat1, lon1, lat2, lon2) {
        const R = 3958.8;
        const dLat = (lat2 - lat1) * Math.PI / 180;
        const dLon = (lon2 - lon1) * Math.PI / 180;
        const a = Math.sin(dLat/2)**2 +
        Math.cos(lat1 * Math.PI/180) * Math.cos(lat2 * Math.PI/180) * Math.sin(dLon/2)**2;
        return R * 2 * Math.asin(Math.sqrt(a));
        }

        markerEntries.forEach(entry => {
        entry.data._distance = haversineMiles(avgLat, avgLng, entry.data.lat, entry.data.lng);
        });

        // Apply the pre-selected cuisine filter on page load
        applyFilters();

        // ── Randomizer ───────────────────────────────────────────────────────

        let lastRandId = null;

        function getFilteredCandidates() {
        return markerEntries.filter(entry => entry.matchesFilters);
        }

        function pickRandom(exclude) {
        const candidates = getFilteredCandidates();
        const pool = candidates.filter(entry => entry.data.id !== exclude);
        if (pool.length === 0) return candidates[0] ?? null;
        return pool[Math.floor(Math.random() * pool.length)];
        }

        function showRandomResult(entry) {
        if (!entry) {
        randomizerResult.setAttribute("hidden", "");
        return;
        }
        const r = entry.data;
        lastRandId = r.id;
        randName.textContent = r.name;
        randMeta.textContent = [r.priceTier, r.cuisine, r._distance != null ? r._distance.toFixed(1) + " mi" : ""].filter(Boolean).join(" · ");
        randomizerResult.removeAttribute("hidden");

        // Pan map to the chosen restaurant
        map.setView([r.lat, r.lng], Math.max(map.getZoom(), 15));
        updateFilterCount(Boolean(
        (filterName?.value ?? "").trim() ||
        (filterCuisine?.value ?? "") ||
        (filterPrice?.value ?? "") ||
        (filterDistance?.value ?? "")));
        }

        randomBtn?.addEventListener("click", () => {
        applyFilters();
        const picked = pickRandom(null);
        if (!picked) {
        alert("No restaurants match the current filters. Try adjusting the cuisine, price, or distance.");
        return;
        }
        showRandomResult(picked);
        });

        randPickAnother?.addEventListener("click", () => {
        const picked = pickRandom(lastRandId);
        showRandomResult(picked);
        });

        randConfirm?.addEventListener("click", () => {
        if (!lastRandId) return;
        const entry = markerEntries.find(item => item.data.id === lastRandId);
        if (entry) selectRestaurant(lastRandId, entry.data.name);
        randomizerResult.setAttribute("hidden", "");
        lastRandId = null;
        });

        // ── Helpers ──────────────────────────────────────────────────────────

        function escHtml(str) {
        return String(str ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;");
        }

        }());
    </script>
}
