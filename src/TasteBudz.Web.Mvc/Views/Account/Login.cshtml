@model LoginViewModel

@{
    ViewData["Title"] = "Log In";
}

<section class="hero-grid auth-page">

    <div class="card auth-card">
        <div class="stack">
            <div>
                <h2 class="card__title">Welcome back</h2>
                <p class="card__subtitle">Use your username or email, then continue where you left off.</p>
            </div>

            <form asp-action="Login" method="post" class="stack-lg" novalidate>
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <div class="field">
                    <label asp-for="UsernameOrEmail"></label>
                    <input asp-for="UsernameOrEmail" autocomplete="username" placeholder="alex or alex@example.com" />
                    <span asp-validation-for="UsernameOrEmail" class="field-validation-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" autocomplete="current-password" placeholder="Password" />
                    <span asp-validation-for="Password" class="field-validation-error"></span>
                </div>

                <button type="submit" class="primary-btn">Log In</button>
            </form>
        </div>

        <div class="divider">Don't have an Account?</div>

        <div>
            <a asp-controller="Account" asp-action="CreateAccount" class="button button--primary" style="display:block;text-align:center;">Create an Account</a>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
