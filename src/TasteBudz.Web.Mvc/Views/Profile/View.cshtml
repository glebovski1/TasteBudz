@model DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";

    string StatusChipClass(TasteBudz.Backend.Domain.EventStatus status) =>
        $"interest-card__chip interest-card__chip--{status.ToString().ToLowerInvariant()}";
}

<section class="profile-shell">

    <!--Tab Navigation-->
    <div class="profile-menu">
        <button type="button" onclick="showSection('profile-info')" class="active">Profile Info</button>
        <button type="button" onclick="showSection('friends')">Budz</button>
        <button type="button" onclick="showSection('events')">My Events</button>
        <button type="button" onclick="showSection('groups')">Groups</button>
    </div>

    <!--Tab Panels-->
    <div class="profile-content">

        <div id="friends" class="section">
            <h2>Your Budz</h2>
            <div class="panel__items interest-card-list">
                @if (Model.Budz.Count == 0)
                {
                    <p class="empty-state">No Budz connections yet.</p>
                }
                else
                {
                    @foreach (var item in Model.Budz)
                    {
                        <article class="summary-card interest-card interest-card--person">
                            <div class="interest-card__header">
                                <button type="button"
                                        class="interest-card__avatar-trigger"
                                        onclick="openUserCard('@item.UserId')"
                                        aria-label="View @item.DisplayName's profile">
                                    <span class="interest-card__avatar-shell">
                                        @if (item.AvatarUrl is not null)
                                        {
                                            <img src="@item.AvatarUrl" alt="" class="interest-card__avatar-image" />
                                        }
                                        else
                                        {
                                            <span class="interest-card__avatar">@item.Initial</span>
                                        }
                                    </span>
                                </button>

                                <div class="interest-card__body">
                                    <button type="button"
                                            class="interest-card__identity interest-card__identity--button"
                                            onclick="openUserCard('@item.UserId')"
                                            aria-label="View @item.DisplayName's profile">
                                        <span class="interest-card__title">@item.DisplayName</span>
                                        <span class="interest-card__subtitle">@@@item.Username</span>
                                    </button>

                                    <div class="interest-card__chips">
                                        @if (item.PreviewFoodTags.Count == 0)
                                        {
                                            <span class="interest-card__chip interest-card__chip--muted">No public food preferences yet</span>
                                        }
                                        else
                                        {
                                            @foreach (var tag in item.PreviewFoodTags)
                                            {
                                                <span class="interest-card__chip">@tag</span>
                                            }

                                            @if (item.HiddenFoodTagCount > 0)
                                            {
                                                <span class="interest-card__chip interest-card__chip--muted">+@item.HiddenFoodTagCount more</span>
                                            }
                                        }
                                    </div>

                                </div>

                                <div class="interest-card__actions interest-card__actions--top">
                                    <button type="button"
                                            class="interest-card__icon-action"
                                            onclick="openUserCard('@item.UserId')"
                                            aria-label="Open @item.DisplayName's profile">
                                        ...
                                    </button>
                                </div>
                            </div>

                            <div class="interest-card__facts">
                                <span class="interest-card__fact">Budz</span>
                                <span class="interest-card__fact">@item.ConnectedLabel</span>
                                @if (item.GoalLabel is not null)
                                {
                                    <span class="interest-card__fact">@item.GoalLabel</span>
                                }
                                @if (item.ZipLabel is not null)
                                {
                                    <span class="interest-card__fact">@item.ZipLabel</span>
                                }
                            </div>
                        </article>
                    }
                }
            </div>
        </div>

        <div id="events" class="section">
            <h2>My Events</h2>
            <div class="my-events-filter-bar" aria-label="My events filters">
                <button type="button" class="my-events-filter is-active" data-my-events-filter="all">All</button>
                <button type="button" class="my-events-filter" data-my-events-filter="group">Group events</button>
                <button type="button" class="my-events-filter" data-my-events-filter="ordinary">Standalone events</button>
                <button type="button" class="my-events-filter" data-my-events-filter="open">Active/Open</button>
                <button type="button" class="my-events-filter" data-my-events-filter="full">Full</button>
                <button type="button" class="my-events-filter" data-my-events-filter="confirmed">Confirmed</button>
                <button type="button" class="my-events-filter" data-my-events-filter="completed">Completed</button>
                <button type="button" class="my-events-filter" data-my-events-filter="cancelled">Cancelled</button>
            </div>
            <div class="panel__items interest-card-list">
                @if (Model.MyEvents.Count == 0)
                {
                    <p class="empty-state">No events tied to you yet.</p>
                }
                else
                {
                    @foreach (var item in Model.MyEvents)
                    {
                        <article class="summary-card interest-card interest-card--event"
                                 data-my-event-card
                                 data-event-scope="@item.ScopeFilterValue"
                                 data-event-status="@item.StatusFilterValue">
                            <div class="interest-card__header">
                                <div class="interest-card__stamp" aria-hidden="true">
                                    <span class="interest-card__stamp-month">@item.MonthLabel</span>
                                    <span class="interest-card__stamp-day">@item.DayLabel</span>
                                </div>

                                <div class="interest-card__body">
                                    <div class="interest-card__heading">
                                        <strong class="interest-card__title">@item.Title</strong>
                                        <time class="interest-card__subtitle" datetime="@item.EventStartAtUtc.ToString("O")">
                                            @item.ScheduleLabel
                                        </time>
                                    </div>

                                    <div class="interest-card__chips">
                                        <span class="@StatusChipClass(item.Status)">@item.Status</span>
                                        @if (item.HasGroupScope)
                                        {
                                            <span class="interest-card__chip">@item.ScopeLabel</span>
                                        }
                                        <span class="interest-card__chip">@item.EventTypeLabel</span>
                                        @foreach (var relationship in item.RelationshipLabels)
                                        {
                                            <span class="interest-card__chip interest-card__chip--muted">@relationship</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.CuisineTarget))
                                        {
                                            <span class="interest-card__chip">@item.CuisineTarget</span>
                                        }
                                        <span class="interest-card__chip interest-card__chip--muted">@item.TimingChipLabel</span>
                                    </div>

                                    <p class="interest-card__summary">@item.SummaryText</p>
                                </div>

                                <div class="interest-card__actions interest-card__actions--top">
                                    <a asp-controller="Event"
                                       asp-action="EventDetails"
                                       asp-route-eventId="@item.EventId"
                                       class="interest-card__text-action">Open</a>
                                    @if ((item.IsHosted || item.IsJoined) && item.Status is not TasteBudz.Backend.Domain.EventStatus.Cancelled and not TasteBudz.Backend.Domain.EventStatus.Completed)
                                    {
                                        <a asp-controller="Messaging"
                                           asp-action="EventChat"
                                           asp-route-eventId="@item.EventId"
                                           class="interest-card__text-action">Chat</a>
                                    }
                                </div>
                            </div>

                            <div class="interest-card__facts">
                                <span class="interest-card__fact">@item.ScheduleLabel</span>
                                <span class="interest-card__fact">@item.TimeLabel</span>
                                @if (item.HasGroupScope)
                                {
                                    <span class="interest-card__fact">@item.ScopeLabel</span>
                                }
                                <span class="interest-card__fact">@item.EventTypeLabel</span>
                                @if (!string.IsNullOrWhiteSpace(item.CuisineTarget))
                                {
                                    <span class="interest-card__fact">@item.CuisineTarget</span>
                                }
                            </div>
                        </article>
                    }
                }
            </div>
        </div>

        <div id="groups" class="section">
            <h2>Groups You're In</h2>
            <div class="panel__items interest-card-list">
                @if (Model.ActiveGroups.Count == 0)
                {
                    <p class="empty-state">No active groups yet.</p>
                }
                else
                {
                    @foreach (var item in Model.ActiveGroups)
                    {
                        <article class="summary-card interest-card interest-card--group">
                            <div class="interest-card__header">
                                <div class="interest-card__avatar-shell interest-card__avatar-shell--initial" aria-hidden="true">
                                    <span class="interest-card__avatar">@item.Initial</span>
                                </div>

                                <div class="interest-card__body">
                                    <div class="interest-card__heading">
                                        <strong class="interest-card__title">@item.Name</strong>
                                        <span class="interest-card__subtitle">@item.MembershipLabel</span>
                                    </div>

                                    <div class="interest-card__chips">
                                        <span class="interest-card__chip">@item.VisibilityLabel</span>
                                        <span class="interest-card__chip interest-card__chip--muted">@item.MembershipLabel</span>
                                        <span class="interest-card__chip interest-card__chip--accent group-membership-hint">
                                            @item.MembershipHint
                                        </span>
                                    </div>

                                    <p class="interest-card__summary">@item.SummaryText</p>
                                </div>

                                <div class="interest-card__actions interest-card__actions--top">
                                    <a asp-controller="Group"
                                       asp-action="Manage"
                                       asp-route-groupId="@item.GroupId"
                                       class="interest-card__text-action">Open</a>
                                    <a asp-controller="Messaging"
                                       asp-action="GroupChat"
                                       asp-route-groupId="@item.GroupId"
                                       class="interest-card__text-action">Chat</a>
                                </div>
                            </div>

                            <div class="interest-card__facts">
                                <span class="interest-card__fact">@item.VisibilityLabel</span>
                                <span class="interest-card__fact">@item.MembershipLabel</span>
                                <span class="interest-card__fact">@item.AccessLabel</span>
                            </div>
                        </article>
                    }
                }
            </div>
        </div>

        <div id="profile-info" class="section active">
            <div class="card profile-banner">
                <div>
                    <h1>@Model.DisplayName</h1>

                    <p class="card__subtitle">Public profile preview</p>

                    <div class="interest-card__chips">
                        @if (Model.PublicFoodTags.Count == 0)
                        {
                            <span class="interest-card__chip interest-card__chip--muted">No public food preferences yet</span>
                        }
                        else
                        {
                            @foreach (var tag in Model.PublicFoodTags)
                            {
                                <span class="interest-card__chip">@tag</span>
                            }
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Bio))
                    {
                        <p class="interest-card__note">
                            <span class="interest-card__note-label">Personality</span>
                            @Model.PersonalityText
                        </p>
                    }

                    <p class="interest-card__note">
                        <span class="interest-card__note-label">Goals</span>
                        @Model.GoalsText
                    </p>

                    <div class="profile-meta">
                        <span class="pill">@@@Model.Username</span>
                        <span class="pill">@Model.Email</span>
                        <span class="pill">ZIP @Model.HomeAreaZipCode</span>
                    </div>
                </div>

                <div class="button-row">
                    <a asp-action="Edit" class="button button--primary">Edit Profile</a>
                    <a asp-action="Availability" class="button button--secondary">Manage Availability</a>
                </div>
            </div>
        </div>

    </div>
</section>

<script>
    function showSection(sectionId) {
        document.querySelectorAll(".section").forEach(s => s.classList.remove("active"));
        document.querySelectorAll(".profile-menu button").forEach(b => b.classList.remove("active"));

        document.getElementById(sectionId).classList.add("active");
        event.target.classList.add("active");
    }

    document.querySelectorAll("[data-my-events-filter]").forEach(button => {
        button.addEventListener("click", () => {
            const filter = button.dataset.myEventsFilter;
            document.querySelectorAll("[data-my-events-filter]").forEach(item => item.classList.remove("is-active"));
            button.classList.add("is-active");

            document.querySelectorAll("[data-my-event-card]").forEach(card => {
                const matches = filter === "all" ||
                    card.dataset.eventScope === filter ||
                    card.dataset.eventStatus === filter;

                card.hidden = !matches;
            });
        });
    });
</script>
