<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.9" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="artifacts\\**\\*.cs" />
    <Content Include="..\\TasteBudz.Database\\dbTasteBudz.sqlite.sql" Link="DatabaseScripts\\dbTasteBudz.sqlite.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\\TasteBudz.Database\\dbTasteBudz.sqlite.seed.sql" Link="DatabaseScripts\\dbTasteBudz.sqlite.seed.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\\TasteBudz.Database\\dbTasteBudz.sqlite.testdata.sql" Link="DatabaseScripts\\dbTasteBudz.sqlite.testdata.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
