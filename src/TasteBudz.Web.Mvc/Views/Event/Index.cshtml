@model EventIndexViewModel

@{
    ViewData["Title"] = Model.IsQuickSearch ? "Quick Search" : "Events";
}

<section class="profile-shell">

    <div class="card profile-banner" style="grid-template-columns: 1fr auto;">
        <div>
            <h1>@(Model.IsQuickSearch ? "Quick Event Search 🔎" : "Upcoming Food Events 🍽️")</h1>
            <p>
                @(Model.IsQuickSearch
                    ? "Automatic matches ranked by distance, food preferences, and Budz already in the event."
                    : "Find an event to join, or create your own.")
            </p>
        </div>
        <div class="button-row">
            <a asp-action="CreateEvent" class="button button--primary">+ Create Event</a>
        </div>
    </div>

    <nav class="events-mode-tabs" aria-label="Event browsing modes">
        <a asp-action="Index" class="events-mode-tab @(!Model.IsQuickSearch ? "events-mode-tab--active" : string.Empty)">Browse</a>
        <a asp-action="QuickSearch" class="events-mode-tab @(Model.IsQuickSearch ? "events-mode-tab--active" : string.Empty)">Quick Search</a>
    </nav>

    @if (Model.IsQuickSearch)
    {
        <div class="panel recommendation-banner">
            <div>
                <h2>Recommended for You</h2>
                <p class="muted-note">@(Model.RecommendationSummary ?? "Auto-ranking open events using your saved profile signals.")</p>
            </div>
            <a asp-controller="Profile" asp-action="Edit" class="button button--secondary">Update Preferences</a>
        </div>
    }
    else
    {
        <div class="card stack">
            <form asp-action="Index" method="get" class="stack">
                <div class="button-row" style="align-items: stretch;">
                    <div class="field" style="flex: 1; gap: 0;">
                        <input type="text"
                               name="q"
                               value="@Model.SearchQuery"
                               placeholder="Search events…"
                               aria-label="Search events" />
                    </div>
                    <button type="submit" class="button button--primary">Search</button>
                    @if (!string.IsNullOrWhiteSpace(Model.SearchQuery) || Model.UseMyZip || Model.AvailabilityOnly)
                    {
                        <a asp-action="Index" class="button button--secondary">Clear</a>
                    }
                </div>

                <div class="editor-grid">
                    <section class="panel stack">
                        <label class="checkbox-row">
                            <input type="checkbox" name="useMyZip" value="true" checked="@Model.UseMyZip" />
                            <span>Near my ZIP @(string.IsNullOrWhiteSpace(Model.HomeAreaZipCode) ? string.Empty : Model.HomeAreaZipCode)</span>
                        </label>

                        <div class="field">
                            <label for="radiusMiles">Radius</label>
                            <select id="radiusMiles" name="radiusMiles">
                                @foreach (var option in EventIndexViewModel.AvailableRadiusMiles)
                                {
                                    <option value="@option" selected="@(Model.RadiusMiles == option)">@option miles</option>
                                }
                            </select>
                        </div>
                    </section>

                    <section class="panel stack">
                        <label class="checkbox-row">
                            <input type="checkbox" name="availabilityOnly" value="true" checked="@Model.AvailabilityOnly" />
                            <span>Matches my availability</span>
                        </label>
                        <p class="muted-note">Use saved availability windows to narrow the list.</p>
                    </section>
                </div>
            </form>
        </div>
    }

    @if (Model.ShowAvailabilitySetupCta)
    {
        <div class="panel stack">
            <p class="empty-state">Add at least one availability window before using this filter.</p>
            <div class="button-row">
                <a asp-controller="Profile" asp-action="Availability" class="button button--primary">Manage Availability</a>
            </div>
        </div>
    }
    else if (!Model.Events.Any())
    {
        <div class="panel">
            <p class="empty-state">
                @if (Model.IsQuickSearch)
                {
                    <span>No recommended events right now. Try the standard browse tab or create your own.</span>
                }
                else if (string.IsNullOrWhiteSpace(Model.SearchQuery))
                {
                    <span>No events yet — be the first to create one!</span>
                }
                else
                {
                    <span>No events matched "@Model.SearchQuery".</span>
                }
            </p>
        </div>
    }
    else
    {
        <div class="events-grid">
            @foreach (var ev in Model.Events)
            {
                <article class="card event-card">
                    <div class="event-card__header">
                        <h3 class="event-card__title">@ev.Title</h3>
                        <span class="pill">@ev.EventType</span>
                    </div>

                    <div class="event-card__meta">
                        <span>📅 @ev.EventStartAtUtc.ToLocalTime().ToString("MMM d, yyyy")</span>
                        <span>⏰ @ev.EventStartAtUtc.ToLocalTime().ToString("h:mm tt")</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(ev.CuisineTarget))
                    {
                        <p class="event-card__cuisine">🍴 @ev.CuisineTarget</p>
                    }

                    @if (Model.IsQuickSearch && ev.RecommendationReasons.Any())
                    {
                        <div class="event-card__recommendations">
                            @foreach (var reason in ev.RecommendationReasons)
                            {
                                <span class="pill pill--match">@reason</span>
                            }
                        </div>
                    }

                    <div class="event-card__footer">
                        <span class="event-card__spots">
                            @ev.ActiveParticipants / @ev.Capacity spots filled
                        </span>
                        <span class="pill pill--@ev.Status.ToLower()">@ev.Status</span>
                        <a asp-action="EventDetails" asp-route-eventId="@ev.EventId"
                           class="button button--secondary event-card__action">
                            View
                        </a>
                    </div>
                </article>
            }
        </div>
    }

</section>
