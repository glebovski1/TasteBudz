@model ChatInboxViewModel

@{
    ViewData["Title"] = "Chats";
}

<section class="profile-shell">

    <div class="card profile-banner profile-banner--full">
        <div>
            <h1>Chats</h1>
            <p>Select a group or event to open its chat.</p>
        </div>
    </div>

    @if (!Model.Items.Any())
    {
        <div class="panel empty-state-shell">
            <span class="empty-state-shell__icon" aria-hidden="true">TB</span>
            <h2 class="empty-state-shell__title">No chats yet.</h2>
            <p class="empty-state-shell__copy">Join a group or event first, then your conversations will collect here.</p>
            <div class="button-row">
                <a asp-controller="Group" asp-action="Index" class="button button--secondary">Browse Groups</a>
                <a asp-controller="Event" asp-action="Index" class="button button--primary">Browse Events</a>
            </div>
        </div>
    }
    else
    {
        <ul class="inbox-list">
            @foreach (var item in Model.Items)
            {
                <li class="inbox-item">
                    <a class="inbox-item__link" href="@item.ChatUrl">
                        <div class="inbox-item__avatar">
                            @item.Name.Substring(0, 1).ToUpper()
                        </div>
                        <div class="inbox-item__body">
                            <span class="inbox-item__name">@item.Name</span>
                            <span class="inbox-item__label pill">@item.ScopeLabel</span>
                        </div>
                        <span class="inbox-item__arrow">›</span>
                    </a>
                </li>
            }
        </ul>
    }

</section>
