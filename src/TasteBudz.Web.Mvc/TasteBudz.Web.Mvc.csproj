<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseAppHost>false</UseAppHost>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="artifacts/**/*.cs" />
    <Content Remove="artifacts/**" />
    <None Remove="artifacts/**" />
    <Content Update="appsettings.Development.json;appsettings.Production.json" CopyToPublishDirectory="Never" />
    <None Update="appsettings.Development.json;appsettings.Production.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TasteBudz.Backend\TasteBudz.Backend.csproj" />
  </ItemGroup>

</Project>
