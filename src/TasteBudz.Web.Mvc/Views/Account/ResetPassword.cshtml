@model ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
}

<section class="hero-grid auth-page">
    <div class="card auth-card">
        <div class="stack">
            <div>
                <h2 class="card__title">Create a new password</h2>
                <p class="card__subtitle">Use the reset link from the admin team, then sign in again.</p>
            </div>

            <form asp-action="ResetPassword" method="post" class="stack-lg" novalidate>
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <input asp-for="Token" type="hidden" />

                <div class="field">
                    <label asp-for="NewPassword">New password</label>
                    <input asp-for="NewPassword" autocomplete="new-password" placeholder="New password" />
                    <span asp-validation-for="NewPassword" class="field-validation-error"></span>
                </div>

                <div class="field">
                    <label asp-for="ConfirmPassword">Confirm password</label>
                    <input asp-for="ConfirmPassword" autocomplete="new-password" placeholder="Confirm password" />
                    <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                </div>

                <button type="submit" class="primary-btn">Update Password</button>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
