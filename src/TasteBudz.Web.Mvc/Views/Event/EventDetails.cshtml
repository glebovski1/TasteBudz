@model EventDetailViewModel

@{
    ViewData["Title"] = Model.Title;
    var isActive = Model.Status is "Open" or "Full" or "Confirmed";
    var myFeedback = Model.Feedback.FirstOrDefault(item => item.IsCurrentUser);
}

<section class="profile-shell">

    @* ── Banner ── *@
    <div class="card profile-banner" style="grid-template-columns: 1fr auto;">
        <div>
            <h1>@Model.Title</h1>
            <div class="profile-meta">
                <span class="pill">@Model.EventType</span>
                <span class="pill pill--@Model.Status.ToLower()">@Model.Status</span>
                @if (!string.IsNullOrWhiteSpace(Model.CuisineTarget))
                {
                    <span class="pill">🍴 @Model.CuisineTarget</span>
                }
            </div>
        </div>
        <div class="button-row">
            <a asp-action="Index" class="button button--secondary">Back to Events</a>

            @if ((Model.IsHost || Model.IsParticipant) && isActive)
            {
                <a asp-controller="Messaging"
                   asp-action="EventChat"
                   asp-route-eventId="@Model.EventId"
                   class="button button--secondary">💬 Chat</a>
            }
        </div>
    </div>

    @* ── Event Info ── *@
    <section class="card stack">
        <h2 class="card__title">Event Info</h2>
        <dl class="detail-list">
            <dt>Date</dt>
            <dd>📅 @Model.EventStartAtUtc.ToLocalTime().ToString("dddd, MMMM d, yyyy")</dd>

            <dt>Time</dt>
            <dd>⏰ @Model.EventStartAtUtc.ToLocalTime().ToString("h:mm tt")</dd>

            <dt>Spots</dt>
            <dd>@Model.ActiveParticipants / @Model.Capacity filled</dd>
        </dl>
    </section>

    @if (Model.SelectedRestaurant is not null)
    {
        <section class="card stack">
            <div>
                <h2 class="card__title">@Model.SelectedRestaurant.Name</h2>
                <p class="card__subtitle">@Model.SelectedRestaurant.Location</p>
            </div>

            <div class="profile-meta">
                <span class="pill">@Model.SelectedRestaurant.PriceTier</span>
                @if (!string.IsNullOrWhiteSpace(Model.SelectedRestaurant.CuisineTags))
                {
                    <span class="pill">@Model.SelectedRestaurant.CuisineTags</span>
                }
            </div>

            <div class="button-row">
                <a href="@Model.SelectedRestaurant.GoogleMapsUrl"
                   class="button button--secondary"
                   target="_blank"
                   rel="noopener noreferrer">
                    Open in Google Maps
                </a>
            </div>
        </section>
    }

    @if (Model.SlotReservation is not null)
    {
        <section class="card stack">
            <div>
                <h2 class="card__title">Reserved Slot</h2>
                <p class="card__subtitle">This event is linked to a restaurant-managed slot.</p>
            </div>
            <dl class="detail-list">
                <dt>Reservation</dt>
                <dd>@Model.SlotReservation.Status</dd>
                <dt>Reserved</dt>
                <dd>@Model.SlotReservation.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</dd>
                @if (Model.DiscountActivation is not null)
                {
                    <dt>Discount</dt>
                    <dd>
                        @(Model.DiscountActivation.IsActive ? "Active" : "Inactive")
                        (@Model.DiscountActivation.JoinedParticipantCount / @Model.DiscountActivation.MinThresholdForDiscount participants)
                        @if (Model.DiscountActivation.IsFinalized)
                        {
                            <span>final</span>
                        }
                    </dd>
                }
            </dl>
        </section>
    }

    <section class="card stack">
        <div>
            <h2 class="card__title">Event Feedback</h2>
            @if (Model.AverageRating.HasValue)
            {
                <p class="card__subtitle">
                    Average rating: @Model.AverageRating.Value.ToString("0.0") / 5 from @Model.Feedback.Count feedback entr@(Model.Feedback.Count == 1 ? "y" : "ies")
                </p>
            }
            else
            {
                <p class="card__subtitle">Feedback appears here after participants share how the event went.</p>
            }
        </div>

        @if (Model.CanSubmitFeedback)
        {
            <form asp-action="SaveFeedback" method="post" class="stack">
                @Html.AntiForgeryToken()
                <input type="hidden" name="EventId" value="@Model.EventId" />

                <div class="field">
                    <label for="feedbackRating">Rating</label>
                    <select id="feedbackRating" name="Rating" required>
                        <option value="">Choose a rating</option>
                        @for (var rating = 5; rating >= 1; rating--)
                        {
                            <option value="@rating" selected="@(Model.FeedbackForm.Rating == rating)">
                                @rating / 5
                            </option>
                        }
                    </select>
                </div>

                <div class="field">
                    <label for="feedbackText">Text feedback</label>
                    <textarea id="feedbackText"
                              name="Text"
                              maxlength="1000"
                              rows="4"
                              required>@Model.FeedbackForm.Text</textarea>
                </div>

                <div class="button-row">
                    <button type="submit" class="button button--primary">Save Feedback</button>
                </div>
            </form>

            @if (myFeedback is not null)
            {
                <form asp-action="UploadFeedbackPhoto"
                      method="post"
                      enctype="multipart/form-data"
                      class="stack">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="eventId" value="@Model.EventId" />
                    <div class="field">
                        <label for="feedbackPhoto">Add a photo</label>
                        <input id="feedbackPhoto"
                               name="photo"
                               type="file"
                               accept="image/png,image/jpeg,image/gif,image/webp" />
                    </div>
                    <div class="button-row">
                        <button type="submit" class="button button--secondary">Upload Photo</button>
                    </div>
                </form>
            }
        }

        <div class="panel__items">
            @if (!Model.Feedback.Any())
            {
                <p class="empty-state">No feedback yet.</p>
            }
            else
            {
                @foreach (var feedback in Model.Feedback)
                {
                    <article class="summary-card stack">
                        <div class="member-row">
                            <button class="member-row__profile-trigger"
                                    onclick="openUserCard('@feedback.AuthorUserId')"
                                    aria-label="View @feedback.AuthorDisplayName's profile">
                                <div class="member-row__avatar">@feedback.AuthorDisplayName.Substring(0, 1).ToUpper()</div>
                            </button>
                            <button class="member-row__info member-row__info--clickable"
                                    onclick="openUserCard('@feedback.AuthorUserId')">
                                <strong>@feedback.AuthorDisplayName</strong>
                                <span>@@@feedback.AuthorUsername</span>
                            </button>
                            <span class="pill" style="margin-left:auto;">@feedback.Rating / 5</span>
                        </div>

                        <p>@feedback.Text</p>
                        <p class="muted-note">Updated @feedback.UpdatedAtUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</p>

                        @if (feedback.Photos.Any())
                        {
                            <div class="panel-grid" style="grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));">
                                @foreach (var photo in feedback.Photos)
                                {
                                    <figure class="summary-card stack">
                                        <img src="@Url.Action("FeedbackPhoto", "Event", new { mediaAssetId = photo.MediaAssetId })"
                                             alt="@photo.OriginalFileName"
                                             style="width:100%; aspect-ratio:1 / 1; object-fit:cover; border-radius:8px;" />
                                        @if (feedback.IsCurrentUser)
                                        {
                                            <form asp-action="DeleteFeedbackPhoto" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="eventId" value="@Model.EventId" />
                                                <input type="hidden" name="mediaAssetId" value="@photo.MediaAssetId" />
                                                <button type="submit" class="button button--secondary">Remove</button>
                                            </form>
                                        }
                                    </figure>
                                }
                            </div>
                        }

                        @if (!feedback.IsCurrentUser)
                        {
                            <details class="cancel-details">
                                <summary class="button button--secondary" style="display:inline-block; cursor:pointer;">
                                    Report Feedback
                                </summary>
                                <form asp-action="ReportFeedback" method="post" class="stack" style="margin-top:0.75rem;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="eventId" value="@Model.EventId" />
                                    <input type="hidden" name="authorUserId" value="@feedback.AuthorUserId" />
                                    <div class="field">
                                        <label for="reportReason-@feedback.FeedbackId">Reason</label>
                                        <input id="reportReason-@feedback.FeedbackId"
                                               name="reason"
                                               type="text"
                                               maxlength="250"
                                               required />
                                    </div>
                                    <div class="field">
                                        <label for="reportExplanation-@feedback.FeedbackId">More detail</label>
                                        <textarea id="reportExplanation-@feedback.FeedbackId"
                                                  name="explanation"
                                                  maxlength="500"
                                                  rows="3"></textarea>
                                    </div>
                                    <div class="button-row">
                                        <button type="submit" class="button button--danger">Submit Report</button>
                                    </div>
                                </form>
                            </details>
                        }
                    </article>
                }
            }
        </div>
    </section>

    <div class="panel-grid" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));">

        @* ── Participants panel ── *@
        <section class="panel stack">
            <h2>Attendees</h2>
            <div class="panel__items">
                @if (!Model.Participants.Any())
                {
                    <p class="empty-state">No attendees yet.</p>
                }
                else
                {
                    @foreach (var p in Model.Participants)
                    {
                        <article class="summary-card member-row">

                            @* Clicking the avatar or name opens the profile card *@
                            <button class="member-row__profile-trigger"
                                    onclick="openUserCard('@p.UserId')"
                                    aria-label="View @p.DisplayName's profile">
                                <div class="member-row__avatar">@p.DisplayName.Substring(0, 1).ToUpper()</div>
                            </button>

                            <button class="member-row__info member-row__info--clickable"
                                    onclick="openUserCard('@p.UserId')">
                                <strong>@p.DisplayName</strong>
                                <span>@@@p.Username</span>
                                @if (p.IsHost)
                                {
                                    <span class="pill" style="font-size:0.78rem;">Host</span>
                                }
                            </button>

                            @* Kick button — only the host sees it, and only for non-host attendees *@
                            @if (Model.IsHost && !p.IsHost && isActive)
                            {
                                <form asp-controller="Event"
                                      asp-action="Kick"
                                      asp-route-eventId="@Model.EventId"
                                      asp-route-userId="@p.UserId"
                                      method="post"
                                      style="margin-left:auto;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="button button--danger"
                                            onclick="return confirm('Remove @p.DisplayName from this event?')">
                                        Kick
                                    </button>
                                </form>
                            }

                        </article>
                    }
                }
            </div>
        </section>

        @* ── Host actions panel ── *@
        @if (Model.IsHost)
        {
            <section class="panel stack">
                <h2>Host Controls</h2>
                <p class="muted-note">You are hosting this event.</p>

                @* ── Invite panel — closed events only ── *@
                @if (Model.EventType == "Closed" && isActive)
                {
                    <details class="invite-details">
                        <summary class="button button--secondary" style="display:inline-block; cursor:pointer;">
                            ✉️ Invite People
                        </summary>
                        <form asp-action="Invite" method="post" class="stack" style="margin-top:0.75rem;" id="inviteForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="eventId" value="@Model.EventId" />

                            @if (!Model.Budz.Any() && !Model.InvitableGroups.Any())
                            {
                                <p class="muted-note">You don't have any Budz or group members to invite yet.</p>
                            }
                            else
                            {
                                @* Already-invited/joined usernames so we can grey them out *@
                                var alreadyIn = Model.Participants.Select(p => p.Username).ToHashSet(StringComparer.OrdinalIgnoreCase);

                                @if (Model.Budz.Any())
                                {
                                    <div class="field-group">
                                        <p class="group-label" style="margin:0;">Your Budz</p>
                                        <div class="invite-checklist">
                                            @foreach (var bud in Model.Budz)
                                            {
                                                var disabled = alreadyIn.Contains(bud.Username);
                                                <label class="invite-check @(disabled ? "invite-check--disabled" : "")">
                                                    <input type="checkbox"
                                                           name="usernames"
                                                           value="@bud.Username"
                                                    @(disabled ? "disabled" : "") />
                                                    <span class="invite-check__avatar">@bud.DisplayName.Substring(0, 1).ToUpper()</span>
                                                    <span class="invite-check__info">
                                                        <strong>@bud.DisplayName</strong>
                                                        <span>@@@bud.Username</span>
                                                    </span>
                                                    @if (disabled)
                                                    {
                                                        <span class="pill" style="font-size:0.75rem; margin-left:auto;">Already in</span>
                                                    }
                                                </label>
                                            }
                                        </div>
                                    </div>
                                }

                                @foreach (var group in Model.InvitableGroups.Where(g => g.Members.Any()))
                                {
                                    <div class="field-group">
                                        <div style="display:flex; align-items:center; gap:0.75rem;">
                                            <p class="group-label" style="margin:0;">@group.Name</p>
                                            <button type="button"
                                                    class="button button--secondary button--sm"
                                                    onclick="selectAllGroup('@group.GroupId')">
                                                Select all
                                            </button>
                                        </div>
                                        <div class="invite-checklist" id="group-@group.GroupId">
                                            @foreach (var member in group.Members)
                                            {
                                                var disabled = alreadyIn.Contains(member.Username);
                                                <label class="invite-check @(disabled ? "invite-check--disabled" : "")"
                                                       data-group="@group.GroupId">
                                                    <input type="checkbox"
                                                           name="usernames"
                                                           value="@member.Username"
                                                    @(disabled ? "disabled" : "") />
                                                    <span class="invite-check__avatar">@member.DisplayName.Substring(0, 1).ToUpper()</span>
                                                    <span class="invite-check__info">
                                                        <strong>@member.DisplayName</strong>
                                                        <span>@@@member.Username</span>
                                                    </span>
                                                    @if (disabled)
                                                    {
                                                        <span class="pill" style="font-size:0.75rem; margin-left:auto;">Already in</span>
                                                    }
                                                </label>
                                            }
                                        </div>
                                    </div>
                                }

                                <div class="button-row">
                                    <button type="submit" class="button button--primary">
                                        Send Invites
                                    </button>
                                    <span id="inviteCount" class="muted-note"></span>
                                </div>
                            }
                        </form>
                    </details>
                }

                @if (isActive)
                {
                    @if (Model.SelectedRestaurant is not null && Model.SlotReservation is null && Model.ReservableSlots.Any())
                    {
                        <div class="stack" style="margin-bottom:1rem;">
                            <h3>Reserve a Slot</h3>
                            @foreach (var slot in Model.ReservableSlots)
                            {
                                <form asp-action="ReserveSlot" method="post" class="summary-card">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="eventId" value="@Model.EventId" />
                                    <input type="hidden" name="slotId" value="@slot.SlotId" />
                                    <div>
                                        <strong>@slot.StartsAtUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</strong>
                                        <p class="muted-note">
                                            Ends @slot.EndsAtUtc.ToLocalTime().ToString("h:mm tt") |
                                            Capacity @slot.Capacity
                                            @if (slot.MinThresholdForDiscount.HasValue)
                                            {
                                                <span>| Discount at @slot.MinThresholdForDiscount.Value</span>
                                            }
                                        </p>
                                    </div>
                                    <button type="submit" class="button button--primary">Reserve</button>
                                </form>
                            }
                        </div>
                    }

                    <details class="cancel-details">
                        <summary class="button button--danger" style="display:inline-block; cursor:pointer;">
                            Cancel Event
                        </summary>
                        <form asp-action="Cancel" method="post" class="stack" style="margin-top:0.75rem;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="eventId" value="@Model.EventId" />
                            <div class="field">
                                <label for="cancelReason">Reason for cancellation <span style="color:red">*</span></label>
                                <input id="cancelReason" name="reason" type="text"
                                       maxlength="250"
                                       placeholder="Let attendees know why…"
                                       required />
                            </div>
                            <div class="button-row">
                                <button type="submit" class="button button--danger"
                                        onclick="return confirm('Cancel this event? This cannot be undone.')">
                                    Confirm Cancellation
                                </button>
                            </div>
                        </form>
                    </details>
                }
            </section>
        }

        @* ── Attendee actions panel ── *@
        @if (!Model.IsHost && Model.IsParticipant && isActive)
        {
            <section class="panel stack">
                <h2>Your Participation</h2>
                <p class="muted-note">You are attending this event.</p>

                <form asp-action="Leave" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="eventId" value="@Model.EventId" />
                    <button type="submit" class="button button--secondary"
                            onclick="return confirm('Leave this event?')">
                        Leave Event
                    </button>
                </form>
            </section>
        }

        @* ── Accept invite panel — closed events where user is invited ── *@
        @if (!Model.IsHost && Model.IsInvited && isActive)
        {
            <section class="panel stack">
                <h2>You’re Invited!</h2>
                <p class="muted-note">You have been invited to this event. Would you like to join?</p>
                <div class="button-row">
                    <form asp-action="Accept" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="eventId" value="@Model.EventId" />
                        <button type="submit" class="button button--primary">Accept Invitation</button>
                    </form>
                    <form asp-action="Decline" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="eventId" value="@Model.EventId" />
                        <button type="submit" class="button button--secondary"
                                onclick="return confirm('Decline this invitation?')">
                            Decline
                        </button>
                    </form>
                </div>
            </section>
        }

        @* ── Join panel — open-type events only ── *@
        @if (!Model.IsHost && !Model.IsParticipant && Model.Status == "Open" && Model.EventType == "Open")
        {
            <section class="panel stack">
                <h2>Join this Event</h2>
                <p class="muted-note">@(Model.Capacity - Model.ActiveParticipants) spot(s) remaining.</p>

                <form asp-action="Join" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="eventId" value="@Model.EventId" />
                    <button type="submit" class="button button--primary">Join Event</button>
                </form>
            </section>
        }

    </div>

</section>

@section Scripts {
    <script>
        // "Select all" for a group
        function selectAllGroup(groupId) {
            document.querySelectorAll(`[data-group="${groupId}"] input[type="checkbox"]:not(:disabled)`)
                .forEach(cb => cb.checked = true);
            updateInviteCount();
        }

        // Live count of selected invitees
        function updateInviteCount() {
            const count = document.querySelectorAll('#inviteForm input[type="checkbox"]:checked').length;
            const el = document.getElementById('inviteCount');
            if (el) el.textContent = count > 0 ? `${count} person${count === 1 ? '' : 's'} selected` : '';
        }

        document.querySelectorAll('#inviteForm input[type="checkbox"]')
            .forEach(cb => cb.addEventListener('change', updateInviteCount));
    </script>
}
