@model EventCreateViewModel

@{
    ViewData["Title"] = "Create Event";

    var initialPage = new
    {
        page = Model.RestaurantPage.Page,
        pageSize = Model.RestaurantPage.PageSize,
        totalCount = Model.RestaurantPage.TotalCount,
        totalPages = Model.RestaurantPage.TotalPages,
        restaurants = Model.RestaurantPage.Restaurants.Select(r => new
        {
            id = r.RestaurantId,
            name = r.Name,
            location = r.Location,
            priceTier = r.PriceTier,
            cuisine = r.CuisineTags,
            cuisineTags = r.CuisineTagList,
            lat = r.Latitude,
            lng = r.Longitude,
            googleMapsUrl = r.GoogleMapsUrl,
            discountSlots = r.NextMonthDiscountSlots.Select(slot => new
            {
                id = slot.SlotId,
                startsAtUtc = slot.StartsAtUtc,
                endsAtUtc = slot.EndsAtUtc,
                capacity = slot.Capacity,
                displayText = slot.DisplayText,
                discountText = slot.DiscountText,
            }),
        }),
    };

    var initialPageJson = System.Text.Json.JsonSerializer.Serialize(initialPage);
    var allCuisines = EventCreateViewModel.AvailableCuisineTags;
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<section class="profile-shell create-event-page">
    <div class="card profile-banner" style="grid-template-columns: 1fr auto;">
        <div>
            <h1>@(Model.IsGroupEvent ? "Create Group Event" : "Create Event")</h1>
            @if (Model.IsGroupEvent)
            {
                <p>Plan a dining event for @(string.IsNullOrWhiteSpace(Model.GroupName) ? "this group" : Model.GroupName).</p>
            }
            else
            {
                <p>Set up a food event and invite others to join.</p>
            }
        </div>
        <div class="button-row">
            @if (Model.IsGroupEvent)
            {
                <a asp-controller="Group"
                   asp-action="Manage"
                   asp-route-groupId="@Model.GroupId"
                   class="button button--secondary">Back to Group</a>
            }
            else
            {
                <a asp-action="Index" class="button button--secondary">Back to Events</a>
            }
        </div>
    </div>

    <form asp-action="CreateEvent" method="post" class="stack-lg" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="GroupId" />
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <div class="editor-grid">
            <section class="card stack" style="grid-column: 1 / -1;">
                <div>
                    <h2 class="card__title">Event Details</h2>
                    <p class="card__subtitle">Give your event a name and choose a cuisine theme.</p>
                </div>
                <div class="editor-grid" style="gap: 1rem;">
                    <div class="field">
                        <label asp-for="Title"></label>
                        <input asp-for="Title" placeholder="e.g. Sushi Night, Taco Tuesday" />
                        <span asp-validation-for="Title" class="field-validation-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="CuisineTarget"></label>
                        <select asp-for="CuisineTarget">
                            <option value="">Any cuisine (optional)</option>
                            @foreach (var c in allCuisines)
                            {
                                <option value="@c">@c</option>
                            }
                        </select>
                        <span asp-validation-for="CuisineTarget" class="field-validation-error"></span>
                    </div>
                </div>
            </section>

            <section class="panel stack">
                <div>
                    <h2>Type &amp; Capacity</h2>
                    <p class="card__subtitle">
                        @(Model.IsGroupEvent ? Model.GroupEventTypeNotice : "Open events are public. Closed events are invite-only.")
                    </p>
                </div>
                @if (Model.HasForcedEventType)
                {
                    <input type="hidden" asp-for="EventType" />
                    <div class="event-type-lock" aria-label="Locked event type">
                        <span class="event-type-lock__label">Event Type</span>
                        <strong>@Model.ForcedEventTypeLabel</strong>
                        <span>@Model.GroupEventTypeNotice</span>
                    </div>
                }
                else
                {
                    <div class="field">
                        <label asp-for="EventType"></label>
                        <select asp-for="EventType">
                            <option value="">Select type...</option>
                            <option value="Open">Open - anyone can join</option>
                            <option value="Closed">Closed - invite only</option>
                        </select>
                        <span asp-validation-for="EventType" class="field-validation-error"></span>
                    </div>
                }
                <div class="field">
                    <label asp-for="Capacity"></label>
                    <input asp-for="Capacity" type="number" min="2" max="8" placeholder="2-8 people" />
                    <span asp-validation-for="Capacity" class="field-validation-error"></span>
                </div>
            </section>

            <section class="card stack">
                <div>
                    <h2 class="card__title">Date &amp; Time</h2>
                    <p class="card__subtitle">When is the event taking place?</p>
                </div>
                <div class="field">
                    <label asp-for="EventStartAt"></label>
                    <input asp-for="EventStartAt"
                           type="datetime-local"
                           min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                    <span asp-validation-for="EventStartAt" class="field-validation-error"></span>
                </div>
            </section>

            <section class="card stack" style="grid-column: 1 / -1;">
                <div>
                    <h2 class="card__title">Restaurant <span class="muted-note">(optional)</span></h2>
                    <p class="card__subtitle">Select from the list or map. Discount slots shown here cover the next 30 days.</p>
                </div>

                <input type="hidden" asp-for="SelectedRestaurantId" id="selectedRestaurantId" />
                <input type="hidden" asp-for="SelectedSlotId" id="selectedSlotId" />
                <input type="hidden" asp-for="BrowserTimeZoneOffsetMinutes" id="browserTimeZoneOffsetMinutes" />

                <div class="restaurant-filters">
                    <div class="field" style="margin:0;">
                        <label for="filterName">Search by name</label>
                        <input id="filterName" type="text" placeholder="e.g. Pizza" autocomplete="off" />
                    </div>
                    <div class="field" style="margin:0;">
                        <label for="filterCuisine">Cuisine</label>
                        <select id="filterCuisine">
                            <option value="">All cuisines</option>
                            @foreach (var c in allCuisines)
                            {
                                <option value="@c" selected="@(c.Equals(Model.CuisineTarget, StringComparison.OrdinalIgnoreCase))">@c</option>
                            }
                        </select>
                    </div>
                    <div class="field" style="margin:0;">
                        <label for="filterPrice">Price</label>
                        <select id="filterPrice">
                            <option value="">Any price</option>
                            <option value="One">$ - Budget</option>
                            <option value="Two">$$ - Moderate</option>
                            <option value="Three">$$$ - Upscale</option>
                            <option value="Four">$$$$ - Fine dining</option>
                        </select>
                    </div>
                    <button type="button" id="clearFilters" class="button button--secondary" style="align-self:end; display:none;">
                        Clear
                    </button>
                </div>

                <div class="restaurant-selection-bar" id="selectionBar">
                    <span id="selectionLabel">No restaurant selected.</span>
                    <button type="button" class="button button--secondary button--sm" id="clearSelection" style="display:none;">
                        Clear
                    </button>
                </div>

                <div class="restaurant-picker-layout" aria-label="Restaurant picker">
                    <section class="restaurant-picker-panel stack" aria-label="Restaurant list">
                        <div class="restaurant-picker-toolbar">
                            <p id="pickerCount" class="muted-note">Loading restaurants...</p>
                            <div class="button-row restaurant-picker-pagination">
                                <button type="button" id="restaurantPickerPrev" class="button button--secondary button--sm">Prev</button>
                                <span id="restaurantPickerPageLabel" class="muted-note">Page 1</span>
                                <button type="button" id="restaurantPickerNext" class="button button--secondary button--sm">Next</button>
                            </div>
                        </div>
                        <div id="restaurantPickerList" class="restaurant-picker-list" aria-live="polite"></div>
                    </section>

                    <section class="restaurant-picker-map-panel" aria-label="Restaurant map">
                        <div id="restaurantPickerMap" class="restaurant-map"></div>
                        <p class="muted-note">Map markers match the current restaurant page only. Open in Google Maps links use stored catalog locations.</p>
                    </section>
                </div>
            </section>
        </div>

        <div class="button-row">
            <button type="submit" class="button button--primary">@(Model.IsGroupEvent ? "Create Group Event" : "Create Event")</button>
            @if (Model.IsGroupEvent)
            {
                <a asp-controller="Group"
                   asp-action="Manage"
                   asp-route-groupId="@Model.GroupId"
                   class="button button--secondary">Cancel</a>
            }
            else
            {
                <a asp-action="Index" class="button button--secondary">Cancel</a>
            }
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        (function () {
            const initialPage = @Html.Raw(initialPageJson);
            const pageUrl = "@Url.Action("RestaurantPickerPage", "Event")";
            const hiddenId = document.getElementById("selectedRestaurantId");
            const hiddenSlotId = document.getElementById("selectedSlotId");
            const browserTimeZoneOffset = document.getElementById("browserTimeZoneOffsetMinutes");
            const cuisineTarget = document.getElementById("CuisineTarget");
            const eventStartAt = document.getElementById("EventStartAt");
            const capacityInput = document.getElementById("Capacity");
            const listEl = document.getElementById("restaurantPickerList");
            const mapEl = document.getElementById("restaurantPickerMap");
            const countEl = document.getElementById("pickerCount");
            const pageLabel = document.getElementById("restaurantPickerPageLabel");
            const prevBtn = document.getElementById("restaurantPickerPrev");
            const nextBtn = document.getElementById("restaurantPickerNext");
            const filterName = document.getElementById("filterName");
            const filterCuisine = document.getElementById("filterCuisine");
            const filterPrice = document.getElementById("filterPrice");
            const clearFilters = document.getElementById("clearFilters");
            const selectionLabel = document.getElementById("selectionLabel");
            const clearSelection = document.getElementById("clearSelection");

            if (!listEl || !mapEl) return;

            let currentPage = normalizePage(initialPage);
            let selectedRestaurant = null;
            let map = null;
            let markerLayer = null;
            let markersById = new Map();
            let pendingTimer = null;

            const defaultIcon = L.divIcon({
                className: "map-pin",
                html: "<span></span>",
                iconSize: [24, 24],
                iconAnchor: [12, 12],
                popupAnchor: [0, -12],
            });

            const selectedIcon = L.divIcon({
                className: "map-pin map-pin--selected",
                html: "<span></span>",
                iconSize: [28, 28],
                iconAnchor: [14, 14],
                popupAnchor: [0, -14],
            });

            initMap();
            setBrowserTimeZoneOffset();
            renderPage(currentPage);
            if (hiddenId.value) {
                selectRestaurant(hiddenId.value, null, { pan: false, scroll: false });
            }
            loadPickerPage(currentPage.page, { silent: true });

            filterName?.addEventListener("input", debounceFilter);
            filterCuisine?.addEventListener("change", () => loadPickerPage(1));
            filterPrice?.addEventListener("change", () => loadPickerPage(1));
            prevBtn?.addEventListener("click", () => loadPickerPage(currentPage.page - 1));
            nextBtn?.addEventListener("click", () => loadPickerPage(currentPage.page + 1));
            clearSelection?.addEventListener("click", () => clearRestaurantSelection());
            cuisineTarget?.addEventListener("change", () => {
                if (cuisineTarget.value) clearRestaurantSelection();
            });
            clearFilters?.addEventListener("click", () => {
                if (filterName) filterName.value = "";
                if (filterCuisine) filterCuisine.value = "";
                if (filterPrice) filterPrice.value = "";
                loadPickerPage(1);
            });
            browserTimeZoneOffset?.closest("form")?.addEventListener("submit", setBrowserTimeZoneOffset);

            function debounceFilter() {
                window.clearTimeout(pendingTimer);
                pendingTimer = window.setTimeout(() => loadPickerPage(1), 250);
            }

            async function loadPickerPage(page, options) {
                const targetPage = Math.max(1, page || 1);
                const url = new URL(pageUrl, window.location.origin);
                url.searchParams.set("page", String(targetPage));

                const q = (filterName?.value || "").trim();
                const cuisine = filterCuisine?.value || "";
                const priceTier = filterPrice?.value || "";

                if (q) url.searchParams.set("q", q);
                if (cuisine) url.searchParams.set("cuisine", cuisine);
                if (priceTier) url.searchParams.set("priceTier", priceTier);

                setLoadingState(true, options?.silent === true);

                try {
                    const response = await fetch(url.toString(), { headers: { "Accept": "application/json" } });
                    if (!response.ok) throw new Error("Restaurants unavailable.");
                    currentPage = normalizePage(await response.json());
                    renderPage(currentPage);
                    if (hiddenId.value) {
                        selectRestaurant(hiddenId.value, hiddenSlotId.value ? { id: hiddenSlotId.value } : null, { pan: false, scroll: false });
                    }
                } catch {
                    if (!options?.silent) {
                        listEl.innerHTML = '<p class="empty-state">Could not load restaurants. Try again in a moment.</p>';
                    }
                } finally {
                    setLoadingState(false, false);
                }
            }

            function renderPage(page) {
                renderList(page.restaurants);
                renderMarkers(page.restaurants);
                renderPagination(page);
                updateClearFilters();
            }

            function renderList(restaurants) {
                listEl.innerHTML = "";

                if (restaurants.length === 0) {
                    listEl.innerHTML = '<p class="empty-state">No restaurants match the current filters.</p>';
                    return;
                }

                restaurants.forEach(restaurant => {
                    const card = document.createElement("article");
                    card.className = "restaurant-picker-card";
                    card.dataset.restaurantId = restaurant.id;
                    card.tabIndex = 0;

                    const header = document.createElement("div");
                    header.className = "restaurant-picker-card__header";

                    const title = document.createElement("div");
                    const name = document.createElement("strong");
                    name.textContent = restaurant.name;
                    const meta = document.createElement("span");
                    meta.className = "restaurant-picker-card__meta";
                    meta.textContent = [restaurant.location, restaurant.priceTier, restaurant.cuisine].filter(Boolean).join(" | ");
                    title.append(name, meta);

                    const selectButton = document.createElement("button");
                    selectButton.type = "button";
                    selectButton.className = "button button--secondary button--sm";
                    selectButton.textContent = "Select";
                    selectButton.addEventListener("click", event => {
                        event.stopPropagation();
                        selectRestaurant(restaurant.id, null, { pan: true, scroll: false });
                    });

                    header.append(title, selectButton);
                    card.appendChild(header);

                    if (restaurant.googleMapsUrl) {
                        const mapsLink = document.createElement("a");
                        mapsLink.href = restaurant.googleMapsUrl;
                        mapsLink.target = "_blank";
                        mapsLink.rel = "noopener noreferrer";
                        mapsLink.className = "restaurant-picker-card__maps";
                        mapsLink.textContent = "Open in Google Maps";
                        mapsLink.addEventListener("click", event => event.stopPropagation());
                        card.appendChild(mapsLink);
                    }

                    const slots = Array.isArray(restaurant.discountSlots) ? restaurant.discountSlots : [];
                    if (slots.length > 0) {
                        const slotsWrap = document.createElement("div");
                        slotsWrap.className = "restaurant-picker-slots";

                        const label = document.createElement("span");
                        label.className = "restaurant-picker-slots__label";
                        label.textContent = "Next 30 days";
                        slotsWrap.appendChild(label);

                        slots.slice(0, 2).forEach(slot => {
                            const row = document.createElement("div");
                            row.className = "restaurant-picker-slot";

                            const text = document.createElement("span");
                            text.textContent = slot.displayText + (slot.discountText ? " | " + slot.discountText : "");

                            const slotButton = document.createElement("button");
                            slotButton.type = "button";
                            slotButton.className = "button button--primary button--sm";
                            slotButton.textContent = "Use slot";
                            slotButton.addEventListener("click", event => {
                                event.stopPropagation();
                                selectRestaurant(restaurant.id, slot, { pan: true, scroll: false });
                                applySlot(slot);
                            });

                            row.append(text, slotButton);
                            slotsWrap.appendChild(row);
                        });

                        card.appendChild(slotsWrap);
                    } else {
                        const note = document.createElement("p");
                        note.className = "muted-note";
                        note.textContent = "No discount slots in the next 30 days.";
                        card.appendChild(note);
                    }

                    card.addEventListener("click", () => selectRestaurant(restaurant.id, null, { pan: true, scroll: false }));
                    card.addEventListener("keydown", event => {
                        if (event.key === "Enter" || event.key === " ") {
                            event.preventDefault();
                            selectRestaurant(restaurant.id, null, { pan: true, scroll: false });
                        }
                    });

                    listEl.appendChild(card);
                });

                syncSelectedState();
            }

            function renderMarkers(restaurants) {
                markerLayer.clearLayers();
                markersById = new Map();

                const mapped = restaurants.filter(r => Number.isFinite(r.lat) && Number.isFinite(r.lng));
                mapped.forEach(restaurant => {
                    const marker = L.marker([restaurant.lat, restaurant.lng], { icon: restaurant.id === hiddenId.value ? selectedIcon : defaultIcon });
                    marker.bindPopup(buildPopup(restaurant));
                    marker.on("click", () => selectRestaurant(restaurant.id, null, { pan: false, scroll: true }));
                    marker.addTo(markerLayer);
                    markersById.set(restaurant.id, marker);
                });

                if (mapped.length > 0) {
                    const bounds = L.latLngBounds(mapped.map(r => [r.lat, r.lng]));
                    map.fitBounds(bounds, { padding: [28, 28], maxZoom: 14 });
                } else {
                    map.setView([39.1031, -84.5120], 12);
                }
            }

            function buildPopup(restaurant) {
                const container = document.createElement("div");
                const name = document.createElement("strong");
                name.textContent = restaurant.name;
                container.appendChild(name);
                container.appendChild(document.createElement("br"));
                container.appendChild(document.createTextNode(restaurant.location));
                container.appendChild(document.createElement("br"));

                const meta = document.createElement("span");
                meta.className = "muted-note";
                meta.textContent = [restaurant.priceTier, restaurant.cuisine].filter(Boolean).join(" | ");
                container.appendChild(meta);
                container.appendChild(document.createElement("br"));

                const selectButton = document.createElement("button");
                selectButton.type = "button";
                selectButton.textContent = "Select";
                selectButton.className = "button button--primary button--sm restaurant-picker-popup-button";
                selectButton.addEventListener("click", () => selectRestaurant(restaurant.id, null, { pan: false, scroll: true }));
                container.appendChild(selectButton);

                if (restaurant.googleMapsUrl) {
                    container.appendChild(document.createElement("br"));
                    const mapsLink = document.createElement("a");
                    mapsLink.href = restaurant.googleMapsUrl;
                    mapsLink.target = "_blank";
                    mapsLink.rel = "noopener noreferrer";
                    mapsLink.textContent = "Open in Google Maps";
                    container.appendChild(mapsLink);
                }

                return container;
            }

            function selectRestaurant(id, slot, options) {
                const restaurant = currentPage.restaurants.find(r => r.id === id);
                if (!restaurant) {
                    syncSelectedState();
                    return;
                }

                selectedRestaurant = restaurant;
                hiddenId.value = restaurant.id;
                hiddenSlotId.value = slot?.id || "";
                selectionLabel.textContent = slot?.displayText
                    ? "Selected: " + restaurant.name + " | " + slot.displayText
                    : "Selected: " + restaurant.name;
                clearSelection.style.display = "inline-block";
                if (cuisineTarget) cuisineTarget.value = "";

                syncSelectedState();

                const marker = markersById.get(restaurant.id);
                if (marker) {
                    marker.setIcon(selectedIcon);
                    if (options?.pan) map.setView(marker.getLatLng(), Math.max(map.getZoom(), 14));
                    marker.openPopup();
                }

                if (options?.scroll) {
                    document
                        .querySelector(`[data-restaurant-id="${cssEscape(restaurant.id)}"]`)
                        ?.scrollIntoView({ behavior: "smooth", block: "nearest" });
                }
            }

            function clearRestaurantSelection() {
                selectedRestaurant = null;
                hiddenId.value = "";
                hiddenSlotId.value = "";
                selectionLabel.textContent = "No restaurant selected.";
                clearSelection.style.display = "none";
                syncSelectedState();
            }

            function syncSelectedState() {
                const selectedId = hiddenId.value;

                document.querySelectorAll(".restaurant-picker-card").forEach(card => {
                    card.classList.toggle("restaurant-picker-card--selected", card.dataset.restaurantId === selectedId);
                });

                markersById.forEach((marker, id) => {
                    marker.setIcon(id === selectedId ? selectedIcon : defaultIcon);
                });
            }

            function applySlot(slot) {
                if (eventStartAt && slot.startsAtUtc) {
                    eventStartAt.value = formatDateTimeLocal(new Date(slot.startsAtUtc));
                }

                if (capacityInput && slot.capacity) {
                    capacityInput.value = slot.capacity;
                }
            }

            function setBrowserTimeZoneOffset() {
                if (browserTimeZoneOffset) {
                    browserTimeZoneOffset.value = String(new Date().getTimezoneOffset());
                }
            }

            function formatDateTimeLocal(value) {
                const pad = number => String(number).padStart(2, "0");
                return value.getFullYear()
                    + "-" + pad(value.getMonth() + 1)
                    + "-" + pad(value.getDate())
                    + "T" + pad(value.getHours())
                    + ":" + pad(value.getMinutes());
            }

            function renderPagination(page) {
                const totalPages = Math.max(1, page.totalPages || 1);
                pageLabel.textContent = "Page " + page.page + " of " + totalPages;
                prevBtn.disabled = page.page <= 1;
                nextBtn.disabled = page.page >= totalPages;

                const first = page.totalCount === 0 ? 0 : ((page.page - 1) * page.pageSize) + 1;
                const last = Math.min(page.totalCount, page.page * page.pageSize);
                countEl.textContent = page.totalCount === 0
                    ? "No restaurants found."
                    : "Showing " + first + "-" + last + " of " + page.totalCount + " restaurants.";
            }

            function setLoadingState(isLoading, silent) {
                if (isLoading && !silent) {
                    countEl.textContent = "Loading restaurants...";
                }
                prevBtn.disabled = isLoading || currentPage.page <= 1;
                nextBtn.disabled = isLoading || currentPage.page >= Math.max(1, currentPage.totalPages || 1);
            }

            function updateClearFilters() {
                const hasFilters = Boolean((filterName?.value || "").trim() || filterCuisine?.value || filterPrice?.value);
                clearFilters.style.display = hasFilters ? "inline-block" : "none";
            }

            function initMap() {
                map = L.map("restaurantPickerMap", { scrollWheelZoom: false }).setView([39.1031, -84.5120], 12);
                L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
                    maxZoom: 19,
                }).addTo(map);
                markerLayer = L.layerGroup().addTo(map);
            }

            function normalizePage(page) {
                const restaurants = Array.isArray(page?.restaurants)
                    ? page.restaurants.map(normalizeRestaurant)
                    : [];

                return {
                    page: Math.max(1, Number(page?.page) || 1),
                    pageSize: Math.max(1, Number(page?.pageSize) || 8),
                    totalCount: Math.max(0, Number(page?.totalCount) || 0),
                    totalPages: Math.max(1, Number(page?.totalPages) || 1),
                    restaurants,
                };
            }

            function normalizeRestaurant(restaurant) {
                return {
                    id: String(restaurant.id),
                    name: restaurant.name || "Restaurant",
                    location: restaurant.location || "",
                    priceTier: restaurant.priceTier || "",
                    cuisine: restaurant.cuisine || "",
                    cuisineTags: Array.isArray(restaurant.cuisineTags) ? restaurant.cuisineTags : [],
                    lat: restaurant.lat === null || restaurant.lat === undefined ? null : Number(restaurant.lat),
                    lng: restaurant.lng === null || restaurant.lng === undefined ? null : Number(restaurant.lng),
                    googleMapsUrl: restaurant.googleMapsUrl || "",
                    discountSlots: Array.isArray(restaurant.discountSlots) ? restaurant.discountSlots : [],
                };
            }

            function cssEscape(value) {
                if (window.CSS && CSS.escape) return CSS.escape(value);
                return String(value).replace(/["\\]/g, "\\$&");
            }
        }());
    </script>
}
