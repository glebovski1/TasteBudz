@model RequestPasswordResetViewModel

@{
    ViewData["Title"] = "Request Password Reset";
}

<section class="hero-grid auth-page">
    <div class="card auth-card">
        <div class="stack">
            <div>
                <h2 class="card__title">Request a password reset</h2>
                <p class="card__subtitle">Tell the admin team which username needs help and add the context they should see.</p>
            </div>

            <form asp-action="RequestPasswordReset" method="post" class="stack-lg" novalidate>
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <div class="field">
                    <label asp-for="Username"></label>
                    <input asp-for="Username" autocomplete="username" placeholder="alex" />
                    <span asp-validation-for="Username" class="field-validation-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Message"></label>
                    <textarea asp-for="Message" placeholder="I cannot sign in and need a reset link."></textarea>
                    <span asp-validation-for="Message" class="field-validation-error"></span>
                </div>

                <button type="submit" class="primary-btn">Send Request</button>
            </form>
        </div>

        <div class="divider">Already have a reset link?</div>

        <div class="button-row">
            <a asp-controller="Account" asp-action="ResetPassword" class="button button--secondary">Use Reset Link</a>
            <a asp-controller="Account" asp-action="Login" class="button button--ghost">Back to Log In</a>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
