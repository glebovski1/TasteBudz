@model ChatViewModel

@{
    ViewData["Title"] = Model.Title;
}

<section class="profile-shell">

    <div class="card profile-banner profile-banner--full chat-banner">
        <div>
            <h1>@Model.Title</h1>
            <p>@Model.Subtitle</p>
        </div>
        @if (Model.BackLinkUrl is not null)
        {
            <div class="chat-banner__actions">
                <a href="@Model.BackLinkUrl" class="button button--secondary">@Model.BackLinkText</a>
            </div>
        }
    </div>

    <partial name="_ChatPanel" model="Model" />

</section>

@section Scripts {
    <partial name="_ChatPanelScripts" model="Model" />
}
